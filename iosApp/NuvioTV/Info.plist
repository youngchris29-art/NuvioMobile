<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Plugin repos / addon manifests / scraper fetch() calls can be plain http
		     (e.g. a LAN test repo); mpv already bypasses ATS for playback. -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<!-- External-player handoff (FEAT-5): canOpenURL() silently returns false for any scheme
	     not declared here, and the shared ExternalPlayerPlatform gates its player list on that
	     probe — so this list IS the tvOS player allowlist. Infuse only for now: its
	     x-callback-url API is documented on Apple TV (Infuse 7.6.2+); VLC/Outplayer/VidHub
	     schemes are iOS-verified only, so they stay off until tested on tvOS hardware. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>infuse</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.nuvio.media.NuvioTV.deeplink</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>nuviotv</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
