    "Trakt isn't configured in this build. Add TRAKT_CLIENT_ID and TRAKT_CLIENT_SECRET to local.properties, then rebuild the shared framework.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trakt ist in dieser Version nicht konfiguriert. Füge TRAKT_CLIENT_ID und TRAKT_CLIENT_SECRET zu local.properties hinzu und erstelle dann das gemeinsame Framework erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trakt no está configurado en esta compilación. Añade TRAKT_CLIENT_ID y TRAKT_CLIENT_SECRET a local.properties, luego reconstruye el marco compartido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trakt n'est pas configuré dans cette version. Ajoutez TRAKT_CLIENT_ID et TRAKT_CLIENT_SECRET à local.properties, puis recompilez le framework partagé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trakt non è configurato in questa build. Aggiungi TRAKT_CLIENT_ID e TRAKT_CLIENT_SECRET a local.properties, quindi ricostruisci il framework condiviso."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trakt chưa được cấu hình trong bản dựng này. Thêm TRAKT_CLIENT_ID và TRAKT_CLIENT_SECRET vào local.properties, rồi build lại framework chia sẻ."
          }
        }
      }
    },
