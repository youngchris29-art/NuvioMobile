          "stringUnit": {
            "state": "translated",
            "value": "Tắt · Trailer bắt đầu ở chế độ tắt tiếng"
          }
        }
      }
    },
    "Off · Turn on before walking Home down and back up, or running Detail push/pop cycles": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus · Aktiviere dies, bevor du auf der Startseite nach unten und wieder nach oben scrollst oder Detailseiten öffnest und schließt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado · Actívalo antes de desplazarte hacia abajo y volver arriba en Inicio, o de abrir y cerrar pantallas de detalle"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé · Activez avant de faire défiler l'Accueil vers le bas puis remonter, ou d'ouvrir/fermer des écrans de détail"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Off · Attivalo prima di scorrere la Home in basso e poi di nuovo in alto, o di aprire e chiudere schermate di dettaglio"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt · Bật trước khi cuộn Trang chủ xuống rồi lên lại, hoặc mở/đóng màn hình chi tiết"
          }
        }
      }
    },
    "Off · Turn on if asked to capture a hero artwork report, then relaunch the app": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus · Aktiviere dies, wenn du einen Hero-Artwork-Bericht erstellen sollst, und starte die App neu"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado · Actívalo si te piden capturar un informe del Hero y reinicia la app"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé · Activez si l'on vous demande une capture du Hero, puis relancez l'app"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Off · Attivalo se ti viene chiesto un report dell'artwork del Hero, poi riavvia l'app"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
