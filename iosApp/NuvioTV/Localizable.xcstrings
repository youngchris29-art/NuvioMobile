    "Streams open in %@. Hold a stream to play it in NuvioTV instead; if %@ can’t open, playback falls back to the built-in player.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Streams open in %@. Hold a stream to play it in NuvioTV instead; if %@ can’t open, playback falls back to the built-in player."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Streams open in %@. Hold a stream to play it in NuvioTV instead; if %@ can’t open, playback falls back to the built-in player."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les streams s'ouvrent dans %@. Maintenez un stream pour le lire dans NuvioTV à la place ; si %@ ne peut pas s'ouvrir, la lecture bascule sur le lecteur intégré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I flussi si aprono in %@. Tieni premuto un flusso per riprodurlo in NuvioTV; se %@ non può aprirlo, la riproduzione torna al lettore integrato."
          }
        }
      }
    },
    "Streams play in the built-in player. Hold a stream to open it in an external player instead.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Streams werden im integrierten Player abgespielt. Halte einen Stream, um ihn stattdessen in einem externen Player zu öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los streams se reproducen en el reproductor integrado. Mantén un stream para abrirlo en un reproductor externo en su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les streams sont lus dans le lecteur intégré. Maintenez un stream pour l'ouvrir dans un lecteur externe à la place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I flussi vengono riprodotti nel lettore integrato. Tieni premuto un flusso per aprirlo in un lettore esterno."
          }
        }
      }
    },
