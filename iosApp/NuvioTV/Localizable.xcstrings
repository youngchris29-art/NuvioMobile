    },
    "Cinematic puts the title over a full-bleed backdrop. Classic keeps the earlier page.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Filmisch“ legt den Titel über ein randloses Hintergrundbild. „Klassisch“ behält die frühere Seite bei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinematográfico coloca el título sobre un fondo a pantalla completa. Clásico mantiene la página anterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinématique place le titre sur un fond plein cadre. Classique conserve la page précédente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinematografico mette il titolo su uno sfondo a tutto schermo. Classico mantiene la pagina precedente."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điện ảnh đặt tiêu đề lên ảnh nền tràn màn hình. Cổ điển giữ trang như trước."
          }
        }
      }
    },
    "Cinematic puts the title over a full-width backdrop. Classic keeps the earlier page layout. Default: Cinematic.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Filmisch“ legt den Titel über ein Hintergrundbild in voller Breite. „Klassisch“ behält das frühere Seitenlayout bei. Standard: Filmisch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinematográfico coloca el título sobre un fondo de ancho completo. Clásico mantiene el diseño de página anterior. Por defecto: Cinematográfico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinématique place le titre sur un fond pleine largeur. Classique conserve la mise en page précédente. Par défaut : Cinématique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinematografico mette il titolo su uno sfondo a tutta larghezza. Classico mantiene il layout precedente. Predefinito: Cinematografico."
          }
        },
        "vi": {
