    "Changes made in Nuvio are sent to Simkl immediately. Use Sync Now whenever you want Nuvio to check for remote changes sooner.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen in Nuvio werden sofort an Simkl gesendet. Nutze „Jetzt synchronisieren“, wenn Nuvio früher nach Remote-Änderungen suchen soll."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios hechos en Nuvio se envían a Simkl al instante. Usa «Sincronizar ahora» cuando quieras que Nuvio compruebe antes los cambios remotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications effectuées dans Nuvio sont envoyées immédiatement à Simkl. Utilisez « Synchroniser maintenant » pour que Nuvio vérifie plus tôt les modifications distantes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche fatte in Nuvio vengono inviate subito a Simkl. Usa «Sincronizza ora» quando vuoi che Nuvio controlli prima le modifiche remote."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay đổi trong Nuvio được gửi đến Simkl ngay lập tức. Dùng Đồng bộ ngay khi muốn Nuvio kiểm tra thay đổi từ xa sớm hơn."
          }
        }
      }
    },
    "Check Simkl now instead of waiting for the next automatic check (every %lld minutes).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe Simkl jetzt, statt auf die nächste automatische Prüfung zu warten (alle %lld Minuten)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba Simkl ahora en lugar de esperar a la próxima comprobación automática (cada %lld minutos)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifier Simkl maintenant au lieu d'attendre la prochaine vérification automatique (toutes les %lld minutes)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla Simkl ora invece di aspettare il prossimo controllo automatico (ogni %lld minuti)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra Simkl ngay thay vì chờ lần kiểm tra tự động tiếp theo (mỗi %lld phút)."
          }
        }
      }
    },
