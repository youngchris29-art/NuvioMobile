    },
    "Shows or hides the studio and network logos on title pages. On by default.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blendet die Studio- und Sender-Logos auf Titelseiten ein oder aus. Standardmäßig ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra u oculta los logotipos de estudios y cadenas en las páginas de título. Activado por defecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche ou masque les logos des studios et des chaînes sur les pages de titres. Activé par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra o nasconde i loghi di studi e network nelle pagine dei titoli. Attivato per impostazione predefinita."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện hoặc ẩn logo hãng phim và kênh trên trang tiêu đề. Mặc định bật."
          }
        }
      }
    },
    "Shows placed in Simkl’s On Hold or Dropped lists are hidden from Continue Watching. They remain hidden for as long as they stay in either list.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Serien, die bei Simkl auf „On Hold“ oder „Dropped“ stehen, werden aus „Weiterschauen“ ausgeblendet. Sie bleiben ausgeblendet, solange sie in einer dieser Listen sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las series colocadas en las listas «En espera» o «Abandonada» de Simkl se ocultan de «Seguir viendo». Permanecen ocultas mientras sigan en cualquiera de esas listas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les séries placées dans les listes « En pause » ou « Abandonné » de Simkl sont masquées de « Continuer à regarder ». Elles restent masquées tant qu'elles figurent dans l'une de ces listes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serie nelle liste «In pausa» o «Abbandonata» di Simkl sono nascoste da «Continua a guardare». Restano nascoste finché rimangono in una delle due liste."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phim bộ nằm trong danh sách On Hold hoặc Dropped của Simkl sẽ bị ẩn khỏi Tiếp tục xem. Chúng ẩn chừng nào còn trong hai danh sách đó."
          }
        }
      }
    },
    "Shows posters without the title underneath. Off by default.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt Poster ohne den Titel darunter. Standardmäßig aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra los pósteres sin el título debajo. Desactivado por defecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche les affiches sans le titre en dessous. Désactivé par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra i poster senza il titolo sotto. Disattivato per impostazione predefinita."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị poster không có tiêu đề bên dưới. Mặc định tắt."
          }
        }
      }
    },
    "Shows scroll and push counters for the tab bar. Turn it on only when asked to capture a tab bar problem.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt Scroll- und Push-Zähler für die Tab-Leiste. Nur auf Anfrage einschalten, um ein Problem mit der Tab-Leiste aufzuzeichnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra contadores de desplazamiento y push de la barra de pestañas. Actívalo solo si se te pide capturar un problema de la barra de pestañas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche les compteurs de défilement et de push de la barre d’onglets. À activer uniquement sur demande pour capturer un problème de barre d’onglets."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra i contatori di scorrimento e push della barra delle schede. Attivalo solo se ti viene chiesto di catturare un problema della barra delle schede."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị bộ đếm cuộn và push cho thanh tab. Chỉ bật khi được yêu cầu ghi lại sự cố thanh tab."
          }
        }
      }
    },
    "Shows the Play and other action buttons as icons without text. Off by default.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt die Wiedergabe- und andere Aktionstasten als Symbole ohne Text. Standardmäßig aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra los botones de Reproducir y otras acciones como iconos sin texto. Desactivado por defecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche Lecture et les autres boutons d’action sous forme d’icônes sans texte. Désactivé par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra Riproduci e gli altri pulsanti azione come icone senza testo. Disattivato per impostazione predefinita."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị nút Phát và các nút hành động khác dưới dạng biểu tượng không có chữ. Mặc định tắt."
          }
        }
      }
    },
    "Shows the add-on's logo and name on the right of each source. Off by default.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt Logo und Namen des Add-ons rechts neben jeder Quelle. Standardmäßig aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra el logotipo y el nombre del complemento a la derecha de cada fuente. Desactivado por defecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche le logo et le nom de l’add-on à droite de chaque source. Désactivé par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra il logo e il nome dell’add-on a destra di ogni fonte. Disattivato per impostazione predefinita."
          }
        },
        "vi": {
