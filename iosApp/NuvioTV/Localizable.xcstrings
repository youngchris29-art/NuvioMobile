          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche l’affiche du titre sur le côté droit de l’arrière-plan de la page. Activé par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra il poster del titolo sul lato destro dello sfondo della pagina. Attivato per impostazione predefinita."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị poster của tiêu đề ở phía bên phải nền trang. Mặc định bật."
          }
        }
      }
    },
    "Shows the title, source and time left after you have been paused for a while. This only works in the mpv player. On by default.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt Titel, Quelle und Restzeit an, nachdem du eine Weile pausiert hast. Funktioniert nur im mpv-Player. Standardmäßig ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra el título, la fuente y el tiempo restante tras estar en pausa un rato. Solo funciona en el reproductor mpv. Activado por defecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche le titre, la source et le temps restant après un certain temps de pause. Fonctionne uniquement dans le lecteur mpv. Activé par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra titolo, fonte e tempo rimanente dopo un po’ di pausa. Funziona solo nel player mpv. Attivato per impostazione predefinita."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị tiêu đề, nguồn và thời gian còn lại sau khi bạn tạm dừng một lúc. Chỉ hoạt động trong trình phát mpv. Mặc định bật."
          }
        }
      }
    },
