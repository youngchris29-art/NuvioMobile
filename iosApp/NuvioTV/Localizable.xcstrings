          }
        }
      }
    },
    "Off · add-on release dates are used as-is": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus · Add-on-Veröffentlichungsdaten werden unverändert verwendet"
