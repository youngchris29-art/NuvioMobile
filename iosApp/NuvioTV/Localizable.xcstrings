        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kẻ viền quanh chữ để dễ đọc"
          }
        }
      }
    },
    "Draws a ring in your accent color around the focused poster or card. Off by default.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichnet einen Ring in deiner Akzentfarbe um das fokussierte Poster oder die fokussierte Karte. Standardmäßig aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuja un anillo con tu color de acento alrededor del póster o la tarjeta enfocados. Desactivado por defecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessine un anneau de votre couleur d’accentuation autour de l’affiche ou de la carte ciblée. Désactivé par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disegna un anello nel colore di risalto attorno al poster o al riquadro selezionato. Disattivato per impostazione predefinita."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vẽ một vòng màu nhấn của bạn quanh poster hoặc thẻ đang chọn. Mặc định tắt."
          }
        }
      }
    },
    "Draws a thin dark outline around subtitle text so it stands out on bright scenes. On by default.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeichnet eine dünne dunkle Kontur um den Untertiteltext, damit er sich bei hellen Szenen abhebt. Standardmäßig ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuja un contorno oscuro y fino alrededor del texto de los subtítulos para que destaque en escenas luminosas. Activado por defecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessine un fin contour sombre autour du texte des sous-titres pour qu’il ressorte sur les scènes lumineuses. Activé par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disegna un sottile contorno scuro attorno al testo dei sottotitoli per farlo risaltare nelle scene luminose. Attivato per impostazione predefinita."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vẽ một đường viền tối mỏng quanh chữ phụ đề để nổi bật trên các cảnh sáng. Mặc định bật."
          }
        }
      }
    },
