        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa avatar colorato"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng ảnh đại diện màu"
          }
        }
      }
    },
    "Use the gpu-next (libplacebo) renderer for better HDR tone-mapping. Experimental — Apple TV hardware only (ignored on the Simulator). Applies to the next video.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende den gpu-next (libplacebo) Renderer für besseres HDR-Tone-Mapping. Experimentell – nur Apple-TV-Hardware (wird im Simulator ignoriert). Gilt für das nächste Video."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el renderizador gpu-next (libplacebo) para mejor mapeo de tonos HDR. Experimental — solo hardware de Apple TV (ignorado en el Simulador). Se aplica al siguiente vídeo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise le moteur gpu-next (libplacebo) pour un meilleur tone-mapping HDR. Expérimental — matériel Apple TV uniquement (ignoré sur le simulateur). S'applique à la prochaine vidéo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa il renderer gpu-next (libplacebo) per una migliore mappatura dei toni HDR. Sperimentale — solo hardware Apple TV (ignorato sul simulatore). Si applica al video successivo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng trình kết xuất gpu-next (libplacebo) để tone-map HDR tốt hơn. Thử nghiệm — chỉ trên phần cứng Apple TV (bỏ qua trên Simulator). Áp dụng cho video tiếp theo."
          }
        }
      }
    },
    "Use the official server?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Offiziellen Server verwenden?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Usar el servidor oficial?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser le serveur officiel ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usare il server ufficiale?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng máy chủ chính thức?"
          }
        }
      }
    },
    "Uses TMDB's air dates instead of the dates your add-ons report. Off by default.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet die Erstausstrahlungsdaten von TMDB statt der von deinen Add-ons gemeldeten Daten. Standardmäßig aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa las fechas de emisión de TMDB en lugar de las fechas que informan tus complementos. Desactivado por defecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise les dates de diffusion de TMDB plutôt que les dates indiquées par vos add-ons. Désactivé par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa le date di messa in onda di TMDB invece delle date indicate dai tuoi add-on. Disattivato per impostazione predefinita."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng ngày phát sóng của TMDB thay vì ngày do add-on của bạn báo cáo. Mặc định tắt."
          }
        }
      }
    },
    "Uses a different video renderer for better HDR color. It is experimental, works only on a real Apple TV and applies to the next video. Off by default.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet einen anderen Video-Renderer für bessere HDR-Farben. Er ist experimentell, funktioniert nur auf einem echten Apple TV und gilt für das nächste Video. Standardmäßig aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa otro renderizador de vídeo para un mejor color HDR. Es experimental, solo funciona en un Apple TV real y se aplica al siguiente vídeo. Desactivado por defecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise un autre moteur de rendu vidéo pour de meilleures couleurs HDR. Expérimental, il ne fonctionne que sur une vraie Apple TV et s’applique à la prochaine vidéo. Désactivé par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un diverso renderer video per un colore HDR migliore. È sperimentale, funziona solo su una vera Apple TV e si applica al prossimo video. Disattivato per impostazione predefinita."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng bộ kết xuất video khác để có màu HDR tốt hơn. Đây là tính năng thử nghiệm, chỉ hoạt động trên Apple TV thật và áp dụng cho video tiếp theo. Mặc định tắt."
          }
        }
      }
    },
    "Uses a heavier font for subtitles. Off by default.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet für Untertitel eine kräftigere Schrift. Standardmäßig aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa una tipografía más gruesa para los subtítulos. Desactivado por defecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise une police plus épaisse pour les sous-titres. Désactivé par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un font più spesso per i sottotitoli. Disattivato per impostazione predefinita."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng phông chữ đậm hơn cho phụ đề. Mặc định tắt."
          }
        }
      }
    },
