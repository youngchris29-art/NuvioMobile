          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche les notes IMDb, Rotten Tomatoes, Metacritic, Trakt et Letterboxd sur les pages de titres. Désactivé par défaut."
          }
        },
        "it": {
          "stringUnit": {
