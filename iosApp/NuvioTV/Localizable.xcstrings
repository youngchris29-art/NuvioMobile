        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tráileres empiezan con sonido; reproducir/pausa lo silencia"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les bandes-annonces démarrent avec le son ; lecture/pause coupe le son"
          }
        },
        "it": {
