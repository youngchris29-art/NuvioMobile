          }
        }
      }
    },
    "The next episode’s source failed. Choose one below.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Quelle der nächsten Folge ist fehlgeschlagen. Wähle unten eine aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fuente del siguiente episodio falló. Elige una abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La source de l’épisode suivant a échoué. Choisissez-en une ci-dessous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La fonte del prossimo episodio non è riuscita. Sceglierne una qui sotto."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nguồn của tập tiếp theo bị lỗi. Hãy chọn một nguồn bên dưới."
          }
        }
      }
    },
    "The provider returned an unplayable link.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anbieter hat einen nicht abspielbar Link zurückgegeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proveedor devolvió un enlace no reproducible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fournisseur a renvoyé un lien illisible."
          }
        },
