            "value": "Il codice è scaduto prima di essere approvato. Riprova."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mã đã hết hạn trước khi được duyệt. Thử lại."
          }
        }
      }
    },
    "The code expired. Try again.": {
      "localizations": {
