        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado · las fechas de lanzamiento del complemento se usan tal cual"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé · les dates de sortie des addons sont utilisées telles quelles"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Off · le date di rilascio dei componenti aggiuntivi sono utilizzate così come sono"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt · dùng nguyên ngày phát hành của addon"
          }
        }
      }
    },
    "Off · rows use the add-on's catalog name": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus · Reihen verwenden den Katalognamen des Add-ons"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado · las filas usan el nombre del catálogo del complemento"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé · les lignes utilisent le nom du catalogue de l'addon"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Off · le righe usano il nome del catalogo del addon"
