            "state": "translated",
            "value": "Xóa API key MDBList đã lưu."
          }
        }
      }
    },
    "Clears the saved TMDB key and turns enrichment off.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht den gespeicherten TMDB-Schlüssel und deaktiviert Anreicherung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra la clave TMDB guardada y desactiva el enriquecimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Efface la clé TMDB enregistrée et désactive l'enrichissement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancella la chiave TMDB salvata e disattiva l'arricchimento."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa API key TMDB đã lưu và tắt bổ sung dữ liệu."
          }
        }
      }
    },
    "Clears the saved zoom settings for trailers, so each trailer is measured again the next time it plays.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht die gespeicherten Zoom-Einstellungen für Trailer, sodass jeder Trailer bei der nächsten Wiedergabe neu vermessen wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra los ajustes de zoom guardados de los tráileres, de modo que cada tráiler se vuelve a medir la próxima vez que se reproduzca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Efface les réglages de zoom enregistrés pour les bandes-annonces, afin que chacune soit mesurée à nouveau à sa prochaine lecture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancella le impostazioni di zoom salvate per i trailer, così ogni trailer viene misurato di nuovo alla prossima riproduzione."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa các cài đặt phóng to đã lưu cho trailer, để mỗi trailer được đo lại ở lần phát tiếp theo."
          }
        }
      }
    },
    "Clears what the collection frame probe has recorded so far.": {
      "localizations": {
