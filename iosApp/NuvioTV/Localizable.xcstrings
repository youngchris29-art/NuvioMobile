    "Enrich titles with cast profiles, studios & networks, collections, and better artwork. Titles you open after enabling will be enriched.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reichert Titel mit Besetzungsprofilen, Studios & Sendern, Sammlungen und besserem Bildmaterial an. Titel, die du nach der Aktivierung öffnest, werden angereichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enriquece los títulos con perfiles de reparto, estudios y cadenas, colecciones y mejores imágenes. Los títulos que abras después de activarlo se enriquecerán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enrichit les titres avec des profils de casting, des studios et chaînes, des collections et de meilleures images. Les titres ouverts après activation seront enrichis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Arricchisce i titoli con profili del cast, studi e reti, collezioni e immagini migliori. I titoli aperti dopo l'attivazione verranno arricchiti."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Làm phong phú các tựa phim với hồ sơ diễn viên, hãng phim & kênh truyền hình, bộ sưu tập và hình ảnh đẹp hơn. Các tựa phim bạn mở sau khi bật sẽ được làm phong phú."
          }
        }
      }
    },
    "Enter PIN for %@": {
      "localizations": {
        "de": {
          "stringUnit": {
