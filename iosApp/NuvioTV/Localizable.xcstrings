        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche ou masque la rangée des autres titres de la même collection ou saga. Activé par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra o nasconde la riga degli altri titoli della stessa raccolta o saga. Attivato per impostazione predefinita."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện hoặc ẩn hàng các tiêu đề khác trong cùng bộ sưu tập hoặc loạt phim. Mặc định bật."
          }
        }
      }
    },
    "Shows or hides the row of similar titles. On by default.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blendet die Reihe ähnlicher Titel ein oder aus. Standardmäßig ein."
          }
