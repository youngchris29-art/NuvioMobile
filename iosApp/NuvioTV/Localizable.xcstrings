          }
        }
      }
    },
    "Recently Added": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kürzlich hinzugefügt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agregado recientemente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutés récemment"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunti di recente"
          }
        },
        "vi": {
