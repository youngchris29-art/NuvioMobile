          }
        }
      }
    },
    "Stop Shuffle": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zufallswiedergabe beenden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detener aleatorio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
