          }
        }
      }
    },
    "The beta release this build was cut from. It is empty on builds made directly in Xcode.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Beta-Version, aus der dieser Build erstellt wurde. Bei direkt in Xcode erstellten Builds ist sie leer."
          }
        },
        "es": {
