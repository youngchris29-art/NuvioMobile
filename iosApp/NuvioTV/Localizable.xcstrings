    "Local data on this Apple TV will be cleared. Your synced data stays in your Nuvio account.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Daten auf diesem Apple TV werden gelöscht. Deine synchronisierten Daten bleiben in deinem Nuvio-Konto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos locales en este Apple TV se borrarán. Tus datos sincronizados permanecen en tu cuenta de Nuvio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données locales de cet Apple TV seront effacées. Vos données synchronisées restent dans votre compte Nuvio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati locali su questo Apple TV verranno cancellati. I tuoi dati sincronizzati rimangono nel tuo account Nuvio."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu cục bộ trên Apple TV này sẽ bị xóa. Dữ liệu đã đồng bộ vẫn còn trong tài khoản Nuvio của bạn."
          }
        }
      }
    },
    "Logs stream lookups so you can see why a title finds no sources. Turn it on only when asked.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Protokolliert Stream-Abfragen, damit du siehst, warum ein Titel keine Quellen findet. Nur auf Anfrage einschalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra las búsquedas de streams para que veas por qué un título no encuentra fuentes. Actívalo solo si se te pide."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consigne les recherches de streams pour voir pourquoi un titre ne trouve aucune source. À activer uniquement sur demande."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra le ricerche di stream per vedere perché un titolo non trova fonti. Attivalo solo se richiesto."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi lại các lần tra cứu luồng để bạn thấy vì sao một tiêu đề không tìm được nguồn. Chỉ bật khi được yêu cầu."
          }
        }
      }
    },
