    "Any": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquier"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualsiasi"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tất cả"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beliebig"
          }
        }
      }
    },
    "Any shows all sources. Only keeps Dolby Vision sources. Exclude hides them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Beliebig“ zeigt alle Quellen. „Nur“ behält nur Dolby-Vision-Quellen. „Ausschließen“ blendet sie aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquiera muestra todas las fuentes. Solo conserva únicamente las fuentes Dolby Vision. Excluir las oculta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous affiche toutes les sources. Seulement ne garde que les sources Dolby Vision. Exclure les masque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualsiasi mostra tutte le fonti. Solo mantiene solo le fonti Dolby Vision. Escludi le nasconde."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bất kỳ hiển thị mọi nguồn. Chỉ giữ lại các nguồn Dolby Vision. Loại trừ sẽ ẩn chúng."
          }
        }
      }
    },
    "Any shows all sources. Only keeps HDR sources. Exclude hides them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Beliebig“ zeigt alle Quellen. „Nur“ behält nur HDR-Quellen. „Ausschließen“ blendet sie aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquiera muestra todas las fuentes. Solo conserva únicamente las fuentes HDR. Excluir las oculta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous affiche toutes les sources. Seulement ne garde que les sources HDR. Exclure les masque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualsiasi mostra tutte le fonti. Solo mantiene solo le fonti HDR. Escludi le nasconde."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bất kỳ hiển thị mọi nguồn. Chỉ giữ lại các nguồn HDR. Loại trừ sẽ ẩn chúng."
          }
        }
      }
    },
    "Appearance": {
      "localizations": {
