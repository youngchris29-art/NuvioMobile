            "value": "Recommencer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricomincia"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem lại từ đầu"
          }
        }
      }
    },
    "Start Remote Setup": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Remote-Konfiguration starten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar configuración remota"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrer la configuration à distance"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia configurazione remota"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu thiết lập từ xa"
          }
        }
      }
    },
    "Start searching for sources in the background before the next episode card appears.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Hintergrund mit der Suche nach Quellen beginnen, bevor die Karte für die nächste Folge erscheint."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza a buscar fuentes en segundo plano antes de que aparezca la tarjeta del siguiente episodio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lance la recherche de sources en arrière-plan avant l’apparition de la carte de l’épisode suivant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia a cercare le fonti in background prima che compaia la scheda del prossimo episodio."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu tìm nguồn trong nền trước khi thẻ tập tiếp theo xuất hiện."
          }
        }
      }
    },
    "Starts a local config page on your network.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet eine lokale Konfigurationsseite in deinem Netzwerk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia una página de configuración local en tu red."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarre une page de configuration locale sur votre réseau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia una pagina di configurazione locale sulla tua rete."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khởi động trang cấu hình cục bộ trên mạng của bạn."
          }
        }
      }
    },
    "Starts a small web page on your home network so you can manage add-ons, Home rows, API keys and badge packs from a phone or laptop. Nothing changes until you confirm it here on the TV.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet eine kleine Webseite in deinem Heimnetzwerk, damit du Add-ons, Reihen der Startseite, API-Schlüssel und Badge-Pakete von einem iPhone oder Laptop aus verwalten kannst. Nichts ändert sich, bis du es hier auf dem Fernseher bestätigst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia una pequeña página web en tu red doméstica para que puedas gestionar complementos, filas de Inicio, claves de API y paquetes de insignias desde un iPhone o un portátil. No cambia nada hasta que lo confirmes aquí en el televisor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarre une petite page web sur votre réseau domestique pour gérer add-ons, rangées d’accueil, clés d’API et packs de badges depuis un iPhone ou un ordinateur. Rien ne change tant que vous ne confirmez pas ici sur le téléviseur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia una piccola pagina web sulla tua rete domestica per gestire add-on, righe di Home, chiavi API e pacchetti di badge da un iPhone o da un portatile. Nulla cambia finché non confermi qui sulla TV."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khởi động một trang web nhỏ trên mạng gia đình để bạn quản lý add-on, hàng Trang chủ, khóa API và gói huy hiệu từ iPhone hoặc máy tính xách tay. Không có gì thay đổi cho đến khi bạn xác nhận tại đây trên TV."
          }
        }
      }
    },
    "Starts looking for the next episode's sources about 30 seconds before the Up Next card appears, so playback starts sooner. Off by default.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginnt etwa 30 Sekunden bevor die Karte „Als Nächstes“ erscheint mit der Suche nach den Quellen der nächsten Folge, sodass die Wiedergabe schneller startet. Standardmäßig aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza a buscar las fuentes del siguiente episodio unos 30 segundos antes de que aparezca la tarjeta Siguiente, para que la reproducción empiece antes. Desactivado por defecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commence à chercher les sources de l’épisode suivant environ 30 secondes avant l’apparition de la carte Suivant, pour que la lecture démarre plus vite. Désactivé par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia a cercare le fonti del prossimo episodio circa 30 secondi prima che compaia la scheda Prossimo, così la riproduzione parte prima. Disattivato per impostazione predefinita."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu tìm nguồn của tập tiếp theo khoảng 30 giây trước khi thẻ Tiếp theo xuất hiện, để phát nhanh hơn. Mặc định tắt."
          }
        }
      }
    },
    "Starts trailers with sound on. Press play/pause on the remote to mute. Off by default, so trailers start muted.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet Trailer mit Ton. Zum Stummschalten Wiedergabe/Pause auf der Fernbedienung drücken. Standardmäßig aus, daher starten Trailer stumm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia los tráileres con sonido. Pulsa reproducir/pausa en el mando para silenciar. Desactivado por defecto, por lo que los tráileres empiezan sin sonido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lance les bandes-annonces avec le son. Appuyez sur lecture/pause de la télécommande pour couper le son. Désactivé par défaut, les bandes-annonces démarrent donc sans son."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia i trailer con l’audio. Premi riproduci/pausa sul telecomando per silenziare. Disattivato per impostazione predefinita, quindi i trailer partono senza audio."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu trailer có âm thanh. Nhấn phát/tạm dừng trên điều khiển để tắt tiếng. Mặc định tắt, nên trailer bắt đầu ở chế độ tắt tiếng."
          }
        }
      }
    },
    "Status": {
      "localizations": {
