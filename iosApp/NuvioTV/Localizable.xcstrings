    "Addresses without a scheme are treated as HTTPS — include http:// for a plain-HTTP server.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Adressen ohne Schema werden als HTTPS behandelt — gib http:// an, wenn der Server nur unverschlüsseltes HTTP unterstützt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las direcciones sin esquema se tratan como HTTPS; incluye http:// para un servidor HTTP sin cifrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les adresses sans schéma sont traitées en HTTPS — indiquez http:// pour un serveur en HTTP non chiffré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli indirizzi senza schema vengono trattati come HTTPS — includi http:// per un server che usa solo HTTP."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Địa chỉ không có giao thức sẽ được coi là HTTPS — hãy thêm http:// nếu máy chủ chỉ hỗ trợ HTTP."
          }
        }
      }
    },
    "Adds a Shuffle button to series pages. Off by default.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt Serienseiten eine Zufallswiedergabe-Taste hinzu. Standardmäßig aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un botón Aleatorio a las páginas de series. Desactivado por defecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute un bouton Lecture aléatoire aux pages de séries. Désactivé par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge un pulsante Casuale alle pagine delle serie. Disattivato per impostazione predefinita."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm nút Phát ngẫu nhiên vào trang phim bộ. Mặc định tắt."
          }
        }
      }
    },
    "Adds a badge pack from a JSON web address. Packs you import in the Nuvio phone app sync here on their own.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt ein Badge-Paket über eine JSON-Webadresse hinzu. In der Nuvio-App auf dem iPhone importierte Pakete werden hier automatisch synchronisiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un paquete de insignias desde una dirección web JSON. Los paquetes que importes en la app de Nuvio para el iPhone se sincronizan aquí automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute un pack de badges depuis une adresse web JSON. Les packs importés dans l’app Nuvio sur iPhone se synchronisent ici automatiquement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge un pacchetto di badge da un indirizzo web JSON. I pacchetti importati nell’app Nuvio per iPhone si sincronizzano qui automaticamente."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm gói huy hiệu từ một địa chỉ web JSON. Các gói bạn nhập trong ứng dụng Nuvio trên iPhone sẽ tự động đồng bộ về đây."
          }
        }
      }
    },
    "Adds a dark box behind subtitles to make them easier to read. Default: Off.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt hinter Untertiteln ein dunkles Feld hinzu, damit sie leichter lesbar sind. Standard: Aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un recuadro oscuro detrás de los subtítulos para que se lean mejor. Por defecto: Desactivado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute un fond sombre derrière les sous-titres pour les rendre plus lisibles. Par défaut : Désactivé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge un riquadro scuro dietro i sottotitoli per renderli più leggibili. Predefinito: Disattivato."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm một khung tối phía sau phụ đề để dễ đọc hơn. Mặc định: Tắt."
          }
        }
      }
    },
    "Adds a raised edge highlight and a glossy sheen to cards. Off by default.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt Karten eine erhabene Kantenhervorhebung und einen Glanz hinzu. Standardmäßig aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un borde elevado resaltado y un brillo a las tarjetas. Desactivado por defecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute un bord en relief et un reflet brillant aux cartes. Désactivé par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge ai riquadri un bordo in rilievo evidenziato e un riflesso lucido. Disattivato per impostazione predefinita."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm viền nổi được làm sáng và ánh bóng loáng cho các thẻ. Mặc định tắt."
          }
        }
      }
    },
    "Adds a row under Continue Watching with the next episodes of your shows that air in the next 14 days. On by default.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt unter „Weiterschauen“ eine Reihe mit den nächsten Folgen deiner Serien hinzu, die in den nächsten 14 Tagen erscheinen. Standardmäßig ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una fila bajo Seguir viendo con los próximos episodios de tus series que se emiten en los próximos 14 días. Activado por defecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute une rangée sous Reprendre la lecture avec les prochains épisodes de vos séries diffusés dans les 14 prochains jours. Activé par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge una riga sotto Continua a guardare con i prossimi episodi delle tue serie in onda nei prossimi 14 giorni. Attivato per impostazione predefinita."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm một hàng bên dưới Tiếp tục xem với các tập tiếp theo của chương trình bạn sẽ phát sóng trong 14 ngày tới. Mặc định bật."
          }
        }
      }
    },
    "Adds cast profiles, studios, collections and better artwork from TMDB to titles you open. It uses a key built into the app. Off by default.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt Titeln, die du öffnest, Besetzungsprofile, Studios, Kollektionen und bessere Bilder von TMDB hinzu. Dabei wird ein in die App integrierter Schlüssel verwendet. Standardmäßig aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade perfiles del reparto, estudios, colecciones y mejores imágenes de TMDB a los títulos que abres. Usa una clave integrada en la app. Desactivado por defecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute des profils de distribution, des studios, des collections et de meilleurs visuels de TMDB aux titres que vous ouvrez. Utilise une clé intégrée à l’app. Désactivé par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge ai titoli che apri profili del cast, studi, raccolte e immagini migliori da TMDB. Usa una chiave integrata nell’app. Disattivato per impostazione predefinita."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm hồ sơ diễn viên, hãng phim, bộ sưu tập và hình ảnh đẹp hơn từ TMDB cho các tiêu đề bạn mở. Dùng khóa tích hợp sẵn trong ứng dụng. Mặc định tắt."
          }
        }
      }
    },
    "Adds the type to row names, so a row reads Popular - Movies instead of just Popular. On by default.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt den Typ zu Reihennamen hinzu, sodass eine Reihe „Popular - Movies“ statt nur „Popular“ heißt. Standardmäßig ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade el tipo a los nombres de las filas, de modo que una fila diga Popular - Movies en lugar de solo Popular. Activado por defecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute le type aux noms de rangées, de sorte qu’une rangée s’intitule Popular - Movies au lieu de simplement Popular. Activé par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge il tipo ai nomi delle righe, così una riga diventa Popular - Movies invece di solo Popular. Attivato per impostazione predefinita."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm loại vào tên hàng, để một hàng hiển thị Popular - Movies thay vì chỉ Popular. Mặc định bật."
          }
        }
      }
    },
