    "Auto-play only starts a link your debrid service already has cached. Otherwise it shows the source list. Off by default.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die automatische Wiedergabe startet nur einen Link, den dein Debrid-Dienst bereits im Cache hat. Andernfalls wird die Quellenliste angezeigt. Standardmäßig aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La reproducción automática solo inicia un enlace que tu servicio debrid ya tiene en caché. De lo contrario, muestra la lista de fuentes. Desactivado por defecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lecture auto ne lance qu’un lien que votre service debrid a déjà en cache. Sinon, la liste des sources s’affiche. Désactivé par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La riproduzione automatica avvia solo un link che il tuo servizio debrid ha già in cache. Altrimenti mostra la lista delle fonti. Disattivato per impostazione predefinita."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự động phát chỉ bắt đầu liên kết mà dịch vụ debrid của bạn đã có trong bộ nhớ đệm. Nếu không, sẽ hiện danh sách nguồn. Mặc định tắt."
          }
        }
      }
    },
