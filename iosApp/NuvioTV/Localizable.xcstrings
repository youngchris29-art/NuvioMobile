    "Set Active makes this badge pack decide which chips appear on streams. Delete removes the pack from this Apple TV.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Aktiv setzen“ legt fest, dass dieses Badge-Paket bestimmt, welche Chips bei Streams erscheinen. „Löschen“ entfernt das Paket von diesem Apple TV."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Establecer activo hace que este paquete de insignias decida qué chips aparecen en los streams. Eliminar quita el paquete de este Apple TV."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définir actif fait de ce pack de badges celui qui détermine les pastilles affichées sur les streams. Supprimer retire le pack de cette Apple TV."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta come attivo fa decidere a questo pacchetto di badge quali chip appaiono sugli stream. Elimina rimuove il pacchetto da questa Apple TV."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt làm đang dùng khiến gói huy hiệu này quyết định chip nào xuất hiện trên luồng. Xóa gỡ gói khỏi Apple TV này."
          }
        }
      }
    },
    "Set PIN Lock": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PIN-Sperre einrichten"
          }
        },
        "es": {
