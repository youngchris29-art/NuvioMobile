    "Buffer changes apply to the next playback. Larger buffers smooth out flaky connections at the cost of memory.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pufferänderungen gelten für die nächste Wiedergabe. Größere Puffer glätten instabile Verbindungen auf Kosten des Speichers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios de búfer se aplican en la próxima reproducción. Los búferes más grandes suavizan conexiones inestables a costa de memoria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications de la mémoire tampon s'appliquent à la prochaine lecture. Une mémoire tampon plus grande atténue les connexions instables, au prix d'une utilisation mémoire plus élevée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche del buffer si applicano alla prossima riproduzione. Buffer più grandi uniformano le connessioni instabili al costo della memoria."
          }
        }
      }
    },
