    "Clears the failed sign-in message and goes back to the connect options for this service.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht die Meldung zur fehlgeschlagenen Anmeldung und kehrt zu den Verbindungsoptionen für diesen Dienst zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra el mensaje de inicio de sesión fallido y vuelve a las opciones de conexión de este servicio."
          }
        },
        "fr": {
          "stringUnit": {
