    "Removes sound descriptions and speaker labels, such as [door slams], from text subtitles. Off by default.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt Geräuschbeschreibungen und Sprecherangaben wie [Tür knallt] aus Textuntertiteln. Standardmäßig aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quita las descripciones de sonidos y las etiquetas de hablantes, como [portazo], de los subtítulos de texto. Desactivado por defecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime les descriptions sonores et les étiquettes de locuteurs, comme [porte qui claque], des sous-titres texte. Désactivé par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove dai sottotitoli di testo le descrizioni dei suoni e le etichette dei parlanti, come [porta che sbatte]. Disattivato per impostazione predefinita."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Loại bỏ mô tả âm thanh và nhãn người nói, như [cửa đóng sầm], khỏi phụ đề văn bản. Mặc định tắt."
          }
        }
      }
    },
    "Removes this plugin repository and its providers from this Apple TV.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt dieses Plugin-Repository und seine Provider von diesem Apple TV."
          }
        },
