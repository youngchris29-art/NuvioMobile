            "state": "translated",
            "value": "Connetti un account nelle Impostazioni."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy kết nối tài khoản trong Cài đặt"
          }
        }
      }
    },
    "Connect one in Settings → Account & Services → Debrid, or turn on “Resolve Streams with Debrid”.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect one in Settings → Account & Services → Debrid, or turn on “Resolve Streams with Debrid”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect one in Settings → Account & Services → Debrid, or turn on “Resolve Streams with Debrid”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-en un dans Paramètres → Compte et services → Debrid, ou activez « Résoudre les streams avec Debrid »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connetti uno in Impostazioni → Account e servizi → Debrid, o attiva \"Risolvi flussi con Debrid\"."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối trong Cài đặt → Tài khoản & dịch vụ → Debrid, hoặc bật “Phân giải luồng bằng Debrid”."
          }
        }
      }
    },
    "Connected as %@ · watched history is scrobbled automatically as you play.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbunden als %@ · Ansichtsverlauf wird während der Wiedergabe automatisch gesendet."
          }
        },
        "es": {
