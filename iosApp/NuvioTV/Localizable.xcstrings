            "value": "Xóa thông báo đăng nhập thất bại và quay lại các tùy chọn kết nối cho dịch vụ này."
          }
        }
      }
    },
    "Clears the saved MDBList key.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht den gespeicherten MDBList-Schlüssel."
          }
