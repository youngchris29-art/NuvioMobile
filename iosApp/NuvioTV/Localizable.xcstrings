    "%@ also clears this title’s watched history and rating when it leaves a list.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ löscht auch den Gesehen-Verlauf und die Bewertung dieses Titels, wenn er aus einer Liste entfernt wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ también borra el historial de vistos y la valoración de este título cuando sale de una lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ efface aussi l’historique de visionnage et la note de ce titre quand il quitte une liste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cancella anche la cronologia di visione e la valutazione di questo titolo quando esce da un elenco."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ cũng xóa lịch sử đã xem và đánh giá của tựa này khi nó rời khỏi một danh sách."
          }
        }
      }
    },
