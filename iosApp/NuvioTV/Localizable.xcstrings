    "Your %@ session has expired. Reconnect in Settings → Services → Debrid.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine %@-Sitzung ist abgelaufen. Verbinde erneut unter Einstellungen → Dienste → Debrid."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sesión de %@ ha caducado. Vuelve a conectar en Ajustes → Servicios → Debrid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre session %@ a expiré. Reconnectez-vous dans Réglages → Services → Debrid."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua sessione %@ è scaduta. Ricollega in Impostazioni → Servizi → Debrid."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên %@ của bạn đã hết hạn. Hãy kết nối lại trong Cài đặt → Dịch vụ → Debrid."
          }
        }
      }
    },
    "Your Episode": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Episode"
          }
        },
        "es": {
