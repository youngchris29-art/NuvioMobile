            "value": "Hiển thị toàn bộ tóm tắt"
          }
        }
      }
    },
    "Shows the title's poster on the right side of the page's background. On by default.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt das Poster des Titels auf der rechten Seite des Seitenhintergrunds. Standardmäßig ein."
          }
        },
        "es": {
