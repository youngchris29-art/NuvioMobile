    "Up Next looks for the next episode's sources about 30 seconds before the card appears, so the countdown can start the moment it shows.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Als Nächstes“ sucht etwa 30 Sekunden vor dem Erscheinen der Karte nach den Quellen der nächsten Folge, damit der Countdown sofort beim Einblenden starten kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Siguiente busca las fuentes del siguiente episodio unos 30 segundos antes de que aparezca la tarjeta, para que la cuenta atrás pueda empezar en cuanto se muestre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivant cherche les sources de l’épisode suivant environ 30 secondes avant l’apparition de la carte, pour que le compte à rebours puisse démarrer dès son affichage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prossimo cerca le fonti del prossimo episodio circa 30 secondi prima che compaia la scheda, così il conto alla rovescia può partire appena appare."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiếp theo tìm nguồn của tập tiếp theo khoảng 30 giây trước khi thẻ xuất hiện, để đếm ngược có thể bắt đầu ngay khi hiện."
          }
        }
      }
    },
