          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thất bại gần đây"
          }
        }
      }
    },
    "Falls back to TMDB when the selected account isn't connected.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechselt zu TMDB, wenn das ausgewählte Konto nicht verbunden ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recurre a TMDB cuando la cuenta seleccionada no está conectada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bascule sur TMDB lorsque le compte sélectionné n'est pas connecté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripiega su TMDB quando l'account selezionato non è connesso."
          }
        },
        "vi": {
