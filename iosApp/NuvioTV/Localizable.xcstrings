    "Switch back to api.nuvio.tv. You’ll be signed out and local data on this Apple TV will be cleared.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zurück zu api.nuvio.tv wechseln. Du wirst abgemeldet und lokale Daten auf diesem Apple TV werden gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a api.nuvio.tv. Se cerrará tu sesión y los datos locales en este Apple TV se borrarán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revenez à api.nuvio.tv. Vous serez déconnecté et les données locales de cet Apple TV seront effacées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna ad api.nuvio.tv. Verrai disconnesso e i dati locali su questo Apple TV verranno cancellati."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển về api.nuvio.tv. Bạn sẽ bị đăng xuất và dữ liệu cục bộ trên Apple TV này sẽ bị xóa."
          }
        }
      }
    },
    "Switch the display mode to the video's native frame rate and dynamic range. Also enable Match Content in tvOS Settings → Video and Audio.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte den Anzeigemodus auf die native Bildrate und den dynamischen Bereich des Videos. Aktiviere auch \"Inhalte anpassen\" in tvOS-Einstellungen → Video und Audio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia el modo de visualización a la velocidad de fotogramas nativa del vídeo y rango dinámico. También habilita Coincidir contenido en Configuración de tvOS → Vídeo y audio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bascule le mode d'affichage vers la fréquence d'images et la plage dynamique natives de la vidéo. Activez aussi Match Content dans Réglages tvOS → Vidéo et audio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia la modalità di visualizzazione alla frequenza fotogrammi e all'intervallo dinamico nativi del video. Abilita anche Abbina contenuto in Impostazioni tvOS → Video e audio."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển chế độ hiển thị theo tốc độ khung hình và dải động gốc của video. Đồng thời bật Match Content trong Cài đặt tvOS → Video và Âm thanh."
          }
        }
      }
    },
    "Switch to %@?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu %@ wechseln?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cambiar a %@?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passer à %@ ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passare a %@?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển sang %@?"
          }
        }
      }
    },
    "Switch to a Nuvio account?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu einem Nuvio-Konto wechseln?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cambiar a una cuenta de Nuvio?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passer à un compte Nuvio ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passare a un account Nuvio?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển sang tài khoản Nuvio?"
          }
        }
      }
    },
    "Switches back to the official Nuvio server at api.nuvio.tv. You are signed out and local data on this Apple TV is cleared.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechselt zurück zum offiziellen Nuvio-Server unter api.nuvio.tv. Du wirst abgemeldet und lokale Daten auf diesem Apple TV werden gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve al servidor oficial de Nuvio en api.nuvio.tv. Se cierra tu sesión y se borran los datos locales de este Apple TV."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revient au serveur Nuvio officiel sur api.nuvio.tv. Vous êtes déconnecté et les données locales de cette Apple TV sont effacées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Torna al server Nuvio ufficiale su api.nuvio.tv. Esci dall’account e i dati locali su questa Apple TV vengono cancellati."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển về máy chủ Nuvio chính thức tại api.nuvio.tv. Bạn bị đăng xuất và dữ liệu cục bộ trên Apple TV này bị xóa."
          }
        }
      }
    },
    "Switches the TV to the video's own frame rate and dynamic range while it plays. Off by default.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellt den Fernseher während der Wiedergabe auf die Bildrate und den Dynamikumfang des Videos um. Standardmäßig aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia el televisor a la velocidad de fotogramas y el rango dinámico del propio vídeo mientras se reproduce. Desactivado por defecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fait passer le téléviseur à la fréquence d’images et à la plage dynamique propres à la vidéo pendant sa lecture. Désactivé par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Porta la TV alla frequenza fotogrammi e alla gamma dinamica del video durante la riproduzione. Disattivato per impostazione predefinita."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển TV sang tốc độ khung hình và dải động của chính video trong khi phát. Mặc định tắt."
          }
        }
      }
    },
