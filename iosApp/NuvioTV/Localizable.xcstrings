          }
        }
      }
    },
    "Applies to every add-on's sources on this Apple TV.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für die Quellen aller Add-ons auf diesem Apple TV."
          }
        },
        "es": {
