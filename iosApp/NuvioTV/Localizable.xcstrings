          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferma casuale"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt ngẫu nhiên"
          }
        }
      }
    },
    "Stop waiting and dismiss the code.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beende das Warten und schließe den Code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja de esperar y descarta el código."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêter d'attendre et fermer le code."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Smetti di aspettare e chiudi il codice."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngừng chờ và đóng mã."
          }
        }
      }
    },
    "Stops cards from growing when focused. They keep their size and show focus with a highlight and shadow. Off by default.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verhindert, dass Karten beim Fokussieren wachsen. Sie behalten ihre Größe und zeigen den Fokus mit Hervorhebung und Schatten. Standardmäßig aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita que las tarjetas crezcan al enfocarse. Mantienen su tamaño y muestran el foco con un resalte y una sombra. Desactivado por defecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empêche les cartes de grossir au focus. Elles gardent leur taille et indiquent le focus par une mise en évidence et une ombre. Désactivé par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impedisce ai riquadri di ingrandirsi al focus. Mantengono le dimensioni e mostrano il focus con evidenziazione e ombra. Disattivato per impostazione predefinita."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngăn thẻ phóng to khi được chọn. Thẻ giữ nguyên kích thước và thể hiện tiêu điểm bằng điểm sáng và đổ bóng. Mặc định tắt."
          }
        }
      }
    },
    "Stops waiting for the code to be approved and goes back to the connect options. You can ask for a new code afterwards.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartet nicht mehr auf die Bestätigung des Codes und kehrt zu den Verbindungsoptionen zurück. Danach kannst du einen neuen Code anfordern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja de esperar a que se apruebe el código y vuelve a las opciones de conexión. Después puedes pedir un código nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cesse d’attendre l’approbation du code et revient aux options de connexion. Vous pourrez ensuite demander un nouveau code."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Smette di attendere l’approvazione del codice e torna alle opzioni di collegamento. Dopo potrai richiedere un nuovo codice."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngừng chờ mã được phê duyệt và quay lại các tùy chọn kết nối. Sau đó bạn có thể yêu cầu mã mới."
          }
        }
      }
    },
    "Stream Badges": {
      "localizations": {
