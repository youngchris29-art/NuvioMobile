    "Default shows an icon beside each Settings category. Minimal removes the icons and tightens the rows so more fit on screen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Standard“ zeigt ein Symbol neben jeder Einstellungskategorie. „Minimal“ entfernt die Symbole und verkleinert die Zeilen, sodass mehr auf den Bildschirm passen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Predeterminado muestra un icono junto a cada categoría de Ajustes. Mínimo quita los iconos y reduce las filas para que quepan más en pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par défaut affiche une icône à côté de chaque catégorie de Réglages. Minimal supprime les icônes et resserre les lignes pour en afficher davantage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Predefinito mostra un’icona accanto a ogni categoria di Impostazioni. Minimo rimuove le icone e stringe le righe per farne stare di più."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mặc định hiển thị một biểu tượng bên cạnh mỗi danh mục Cài đặt. Tối giản bỏ các biểu tượng và thu hẹp các hàng để vừa nhiều hơn trên màn hình."
          }
        }
      }
    },
