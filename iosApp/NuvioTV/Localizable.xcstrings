    "Personal key saved. Removing it goes back to the built-in key.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Persönlicher Schlüssel gespeichert. Beim Entfernen wird wieder der integrierte Schlüssel verwendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clave personal guardada. Al eliminarla se vuelve a la clave incluida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clé personnelle enregistrée. La supprimer rétablit la clé intégrée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiave personale salvata. Rimuovendola si torna alla chiave inclusa."
