    "api.nuvio.tv is the official server and is already selected.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "api.nuvio.tv ist der offizielle Server und bereits ausgewählt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "api.nuvio.tv es el servidor oficial y ya está seleccionado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "api.nuvio.tv est le serveur officiel et est déjà sélectionné."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "api.nuvio.tv è il server ufficiale ed è già selezionato."
          }
        },
