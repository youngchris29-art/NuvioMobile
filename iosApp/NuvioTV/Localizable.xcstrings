    "Shows each stream's file size, such as 4.2 GB, as a small chip in the source list. On by default.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt die Dateigröße jedes Streams, etwa 4,2 GB, als kleinen Chip in der Quellenliste. Standardmäßig ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra el tamaño de archivo de cada stream, como 4,2 GB, en un pequeño chip de la lista de fuentes. Activado por defecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche la taille du fichier de chaque stream, par exemple 4,2 Go, dans une petite pastille de la liste des sources. Activé par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra la dimensione del file di ogni stream, come 4,2 GB, in un piccolo chip nella lista delle fonti. Attivato per impostazione predefinita."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị dung lượng tệp của từng luồng, như 4,2 GB, dưới dạng chip nhỏ trong danh sách nguồn. Mặc định bật."
          }
        }
      }
    },
    "Shows or hides the About section with the title's details. On by default.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blendet den Bereich „Info“ mit den Details des Titels ein oder aus. Standardmäßig ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra u oculta la sección Acerca de con los detalles del título. Activado por defecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche ou masque la section À propos avec les détails du titre. Activé par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
