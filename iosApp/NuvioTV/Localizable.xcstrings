            "state": "translated",
            "value": "Dùng TMDB khi tài khoản đã chọn chưa được kết nối."
          }
        }
      }
    },
    "File Size Badges": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateigröße-Badges"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Insignias de tamaño de archivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Badges de taille de fichier"
          }
        },
        "it": {
