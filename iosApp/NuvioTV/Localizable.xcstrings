          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove questo repository di plugin e i suoi provider da questa Apple TV."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gỡ kho plugin này và các nhà cung cấp của nó khỏi Apple TV này."
          }
        }
      }
    },
    "Removes this provider's key from this profile. Streams will no longer resolve through it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt den Schlüssel dieses Anbieters aus diesem Profil. Streams werden nicht mehr dadurch aufgelöst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina la clave de este proveedor de este perfil. Los streams ya no se resolverán a través de él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime la clé de ce fournisseur pour ce profil. Les streams ne seront plus résolus via celui-ci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove la chiave di questo fornitore da questo profilo. I flussi non si risolveranno più attraverso di essa."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa key của nhà cung cấp này khỏi hồ sơ. Luồng sẽ không còn phân giải qua đó."
          }
        }
      }
    },
    "Replaces catalog artwork with posters from a service such as RPDB. Opens a page where you enter the poster URL pattern.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ersetzt Katalog-Artwork durch Poster eines Dienstes wie RPDB. Öffnet eine Seite, auf der du das Muster der Poster-URL eingibst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sustituye las imágenes del catálogo por pósteres de un servicio como RPDB. Abre una página donde introduces el patrón de URL de los pósteres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplace les visuels du catalogue par des affiches d’un service tel que RPDB. Ouvre une page où saisir le modèle d’URL des affiches."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostituisce le immagini del catalogo con poster di un servizio come RPDB. Apre una pagina dove inserire il modello dell’URL dei poster."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay ảnh danh mục bằng poster từ một dịch vụ như RPDB. Mở một trang để bạn nhập mẫu URL poster."
          }
        }
      }
    },
