    "Play Again": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erneut abspielen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproducir de nuevo"
          }
        },
        "fr": {
          "stringUnit": {
