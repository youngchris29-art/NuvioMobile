    },
    "Plays Dolby Vision and HDR10 files in Apple's own player for true Dolby Vision on Apple TV 4K. Everything else stays on the mpv player. On by default.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gibt Dolby-Vision- und HDR10-Dateien im Apple-eigenen Player wieder, für echtes Dolby Vision auf dem Apple TV 4K. Alles andere bleibt im mpv-Player. Standardmäßig ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce archivos Dolby Vision y HDR10 en el reproductor propio de Apple para disfrutar de Dolby Vision real en el Apple TV 4K. Todo lo demás se queda en el reproductor mpv. Activado por defecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit les fichiers Dolby Vision et HDR10 dans le lecteur propre à Apple pour un vrai Dolby Vision sur Apple TV 4K. Tout le reste reste sur le lecteur mpv. Activé par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riproduce i file Dolby Vision e HDR10 nel player di Apple per un vero Dolby Vision su Apple TV 4K. Tutto il resto resta sul player mpv. Attivato per impostazione predefinita."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phát tệp Dolby Vision và HDR10 trong trình phát riêng của Apple để có Dolby Vision thực sự trên Apple TV 4K. Mọi thứ khác vẫn dùng trình phát mpv. Mặc định bật."
          }
        }
      }
    },
    "Plays a muted trailer behind the description on title pages. On by default.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielt hinter der Beschreibung auf Titelseiten einen stummen Trailer ab. Standardmäßig ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce un tráiler sin sonido detrás de la descripción en las páginas de título. Activado por defecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit une bande-annonce muette derrière la description sur les pages de titres. Activé par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riproduce un trailer senza audio dietro la descrizione nelle pagine dei titoli. Attivato per impostazione predefinita."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phát trailer tắt tiếng phía sau phần mô tả trên trang tiêu đề. Mặc định bật."
          }
        }
      }
    },
    "Plays a muted trailer preview after you rest on a poster for a moment. Off by default.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielt eine stumme Trailervorschau ab, nachdem du kurz auf einem Poster verweilt hast. Standardmäßig aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce una vista previa del tráiler sin sonido tras detenerte un momento en un póster. Desactivado por defecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit un aperçu muet de la bande-annonce après un court moment sur une affiche. Désactivé par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riproduce un’anteprima del trailer senza audio dopo che ti fermi un momento su un poster. Disattivato per impostazione predefinita."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phát bản xem trước trailer tắt tiếng sau khi bạn dừng lại trên poster một lúc. Mặc định tắt."
          }
        }
      }
    },
    "Plays the trailer full screen shortly after you open a title. On by default.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielt den Trailer kurz nach dem Öffnen eines Titels im Vollbild ab. Standardmäßig ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce el tráiler a pantalla completa poco después de abrir un título. Activado por defecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit la bande-annonce en plein écran peu après l’ouverture d’un titre. Activé par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riproduce il trailer a schermo intero poco dopo l’apertura di un titolo. Attivato per impostazione predefinita."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phát trailer toàn màn hình ngay sau khi bạn mở một tiêu đề. Mặc định bật."
          }
        }
      }
    },
