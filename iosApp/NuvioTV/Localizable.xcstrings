          }
        }
      }
    },
    "Shows a Skip button during intros and outros when they are known. On by default.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt bei Intros und Outros eine Taste zum Überspringen, wenn sie bekannt sind. Standardmäßig ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra un botón Omitir durante las intros y los créditos finales cuando se conocen. Activado por defecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche un bouton Passer pendant les intros et les génériques de fin lorsqu’ils sont connus. Activé par défaut."
          }
        },
        "it": {
          "stringUnit": {
