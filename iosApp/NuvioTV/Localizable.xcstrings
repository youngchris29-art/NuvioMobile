            "value": "Prima i meno recenti"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cũ nhất trước"
          }
        }
      }
    },
    "On": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "On"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật"
          }
        }
      }
    },
    "On puts the title and description on the left, the artwork on the right, and keeps the banner in place while rows scroll. Off uses the classic layout with the logo at the lower left. Off by default.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Ein“ zeigt Titel und Beschreibung links und das Artwork rechts und hält das Banner an Ort und Stelle, während Reihen scrollen. „Aus“ verwendet das klassische Layout mit dem Logo unten links. Standardmäßig aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado coloca el título y la descripción a la izquierda y la imagen a la derecha, y mantiene el banner fijo mientras las filas se desplazan. Desactivado usa el diseño clásico con el logotipo abajo a la izquierda. Desactivado por defecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé place le titre et la description à gauche, le visuel à droite, et garde la bannière en place pendant le défilement des rangées. Désactivé utilise la mise en page classique avec le logo en bas à gauche. Désactivé par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivato mette titolo e descrizione a sinistra, l’immagine a destra, e tiene fisso il banner mentre le righe scorrono. Disattivato usa il layout classico con il logo in basso a sinistra. Disattivato per impostazione predefinita."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật đặt tiêu đề và mô tả ở bên trái, ảnh ở bên phải, và giữ biểu ngữ cố định khi các hàng cuộn. Tắt dùng bố cục cổ điển với logo ở phía dưới bên trái. Mặc định tắt."
          }
        }
      }
    },
    "On shows a rotating banner at the top of Home, built from up to two of your catalogs. Off shows the focused title's artwork and description instead. On by default.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Ein“ zeigt oben auf der Startseite ein rotierendes Banner aus bis zu zwei deiner Kataloge. „Aus“ zeigt stattdessen Artwork und Beschreibung des fokussierten Titels. Standardmäßig ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado muestra un banner rotativo en la parte superior de Inicio, creado con hasta dos de tus catálogos. Desactivado muestra en su lugar la imagen y la descripción del título enfocado. Activado por defecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé affiche en haut de l’accueil une bannière rotative composée d’un maximum de deux de vos catalogues. Désactivé affiche à la place le visuel et la description du titre ciblé. Activé par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivato mostra in alto in Home un banner a rotazione creato con un massimo di due dei tuoi cataloghi. Disattivato mostra invece l’immagine e la descrizione del titolo selezionato. Attivato per impostazione predefinita."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật hiển thị một biểu ngữ xoay vòng ở đầu Trang chủ, tạo từ tối đa hai danh mục của bạn. Tắt hiển thị ảnh và mô tả của tiêu đề đang chọn thay thế. Mặc định bật."
          }
        }
      }
    },
    "On your phone or computer, go to": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehe auf deinem Phone oder Computer zu"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En tu teléfono o computadora, ve a"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur votre téléphone ou ordinateur, allez sur"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sul tuo telefono o computer, vai a"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên điện thoại hoặc máy tính, truy cập"
          }
        }
      }
    },
    "On · %@": {
