    "JS plugin providers add extra stream sources. Install a repository by its manifest URL — it syncs to your other Nuvio devices automatically.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "JS-Plugin-Anbieter fügen zusätzliche Stream-Quellen hinzu. Installiere ein Repository über seine Manifest-URL – es wird automatisch mit deinen anderen Nuvio-Geräten synchronisiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los proveedores de complementos JS añaden fuentes de stream adicionales. Instala un repositorio por su URL de manifiesto — se sincroniza con tus otros dispositivos Nuvio automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
