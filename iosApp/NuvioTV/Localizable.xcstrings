    "Theme and poster style, plus card depth and badges": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Design und Posterstil sowie Kartentiefe und Badges"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema y estilo de póster, además de profundidad de tarjetas e insignias"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Thème et style des affiches, ainsi que profondeur des cartes et badges"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema e stile dei poster, più profondità dei riquadri e badge"
