    "Stream lookup failed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stream-Suche fehlgeschlagen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Búsqueda de stream fallida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de la recherche de stream."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricerca flusso non riuscita."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tra cứu luồng thất bại."
          }
        }
      }
    },
    "Stream lookups are logged below — open the title that fails, press Play, then come back and photograph": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stream-Abfragen werden unten protokolliert – öffne den fehlschlagenden Titel, drücke Wiedergabe, kehre zurück und fotografiere"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las búsquedas de streams se registran abajo: abre el título que falla, pulsa Reproducir, vuelve y fotografía"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les recherches de streams sont consignées ci-dessous : ouvrez le titre qui échoue, appuyez sur Lecture, revenez et photographiez"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le ricerche di stream sono registrate qui sotto: apri il titolo che non funziona, premi Riproduci, torna indietro e fotografa"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các lần tra cứu luồng được ghi bên dưới — hãy mở tiêu đề bị lỗi, nhấn Phát, rồi quay lại và chụp ảnh"
          }
        }
      }
    },
    "Streaming Buffer": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Streaming-Puffer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Búfer de streaming"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mémoire tampon"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Buffer streaming"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ đệm phát trực tuyến"
          }
        }
      }
    },
    "Streams open in %@. Hold a stream to play it in NuvioTV instead; if %@ can’t open, playback falls back to the built-in player.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Streams open in %@. Hold a stream to play it in NuvioTV instead; if %@ can’t open, playback falls back to the built-in player."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Streams open in %@. Hold a stream to play it in NuvioTV instead; if %@ can’t open, playback falls back to the built-in player."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les streams s'ouvrent dans %@. Maintenez un stream pour le lire dans NuvioTV à la place ; si %@ ne peut pas s'ouvrir, la lecture bascule sur le lecteur intégré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I flussi si aprono in %@. Tieni premuto un flusso per riprodurlo in NuvioTV; se %@ non può aprirlo, la riproduzione torna al lettore integrato."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luồng mở trong %@. Giữ một luồng để phát trong NuvioTV; nếu %@ không mở được, sẽ phát bằng trình phát tích hợp."
          }
        }
      }
    },
    "Streams play in the built-in player. Hold a stream to open it in an external player instead.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Streams werden im integrierten Player abgespielt. Halte einen Stream, um ihn stattdessen in einem externen Player zu öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los streams se reproducen en el reproductor integrado. Mantén un stream para abrirlo en un reproductor externo en su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les streams sont lus dans le lecteur intégré. Maintenez un stream pour l'ouvrir dans un lecteur externe à la place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I flussi vengono riprodotti nel lettore integrato. Tieni premuto un flusso per aprirlo in un lettore esterno."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luồng phát bằng trình phát tích hợp. Giữ một luồng để mở bằng trình phát ngoài."
          }
        }
      }
    },
