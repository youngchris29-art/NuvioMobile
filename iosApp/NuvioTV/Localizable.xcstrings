    "Puts all card depth settings back to their defaults, which also turns card depth off.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt alle Einstellungen zur Kartentiefe auf ihre Standardwerte zurück, wodurch die Kartentiefe auch ausgeschaltet wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restablece todos los ajustes de profundidad de las tarjetas a sus valores predeterminados, lo que también desactiva la profundidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétablit tous les réglages de profondeur des cartes à leurs valeurs par défaut, ce qui désactive aussi la profondeur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riporta tutte le impostazioni di profondità dei riquadri ai valori predefiniti, il che disattiva anche la profondità."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt lại mọi cài đặt chiều sâu của thẻ về mặc định, đồng thời tắt chiều sâu thẻ."
          }
        }
      }
    },
    "Puts the poster size, corners, title labels and wide-row choice back to their defaults.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt Postergröße, Ecken, Titelbeschriftungen und die Auswahl breiter Reihen auf die Standardwerte zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restablece el tamaño de los pósteres, las esquinas, las etiquetas de título y la opción de fila ancha a sus valores predeterminados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétablit par défaut la taille des affiches, les coins, les titres et le choix de rangée large."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riporta ai valori predefiniti dimensione dei poster, angoli, etichette dei titoli e scelta della riga larga."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt lại kích thước poster, góc bo, nhãn tiêu đề và lựa chọn hàng rộng về mặc định."
          }
        }
      }
    },
