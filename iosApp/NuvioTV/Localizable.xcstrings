          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "BUG-122 : Reprendre la lecture, À venir et les rangées de collections se posent comme les rangées d’affiches"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "BUG-122: Continua a guardare, In arrivo e le righe delle raccolte si fermano come le righe di poster"
