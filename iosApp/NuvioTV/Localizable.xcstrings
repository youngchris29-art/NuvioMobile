    "Short Row Floor (A/B)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurzreihen-Untergrenze (A/B)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suelo de fila corta (A/B)"
          }
        },
        "fr": {
          "stringUnit": {
