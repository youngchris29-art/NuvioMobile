            "value": "Il tuo episodio"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tập của bạn"
          }
        }
      }
    },
    "Your add-ons don't expose browsable catalogs.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Add-ons stellen keine durchsuchbar Kataloge bereit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus complementos no exponen catálogos navegables."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos addons n'exposent aucun catalogue navigable."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi componenti aggiuntivi non espongono cataloghi sfogliabili."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Addon của bạn không có danh mục để duyệt."
          }
        }
      }
    },
    "Your installed addons either don’t serve streams, or don’t cover this content type.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine installierten Add-ons liefern entweder keine Streams oder decken diesen Inhaltstyp nicht ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus complementos instalados no ofrecen streams o no cubren este tipo de contenido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos add-ons installés ne fournissent pas de streams ou ne couvrent pas ce type de contenu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi add-on installati non offrono stream o non coprono questo tipo di contenuto."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các add-on đã cài của bạn hoặc không cung cấp luồng, hoặc không hỗ trợ loại nội dung này."
          }
        }
      }
    },
    "Your library is empty": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Bibliothek ist leer"
          }
        },
        "es": {
