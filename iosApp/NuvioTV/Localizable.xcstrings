            "value": "Ajoutez-en un dans l’onglet Add-ons."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungine uno nella scheda Add-on."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm một add-on trong tab Add-on."
          }
        }
      }
    },
