    "Hide sound descriptions and speaker labels from text subtitles.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blende Geräuschbeschreibungen und Sprecherkennzeichnungen aus Textuntertiteln aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta descripciones de sonido y etiquetas de hablantes en los subtítulos de texto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masque les descriptions sonores et les étiquettes de locuteurs des sous-titres texte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasconde le descrizioni dei suoni e le etichette dei parlanti dai sottotitoli di testo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ẩn mô tả âm thanh và nhãn người nói khỏi phụ đề văn bản."
          }
        }
      }
    },
    "Hide sources your debrid service has not cached.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blendet Quellen aus, die dein Debrid-Dienst nicht im Cache hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta las fuentes que tu servicio debrid no tiene en caché."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masque les sources que votre service debrid n’a pas en cache."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasconde le fonti che il tuo servizio debrid non ha in cache."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ẩn các nguồn mà dịch vụ debrid của bạn chưa lưu đệm."
          }
        }
      }
    },
    "Hides sources below this resolution. Sources with no resolution tag are kept.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blendet Quellen unterhalb dieser Auflösung aus. Quellen ohne Auflösungsangabe bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta las fuentes con una resolución inferior a esta. Se conservan las fuentes sin etiqueta de resolución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masque les sources sous cette résolution. Les sources sans balise de résolution sont conservées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasconde le fonti sotto questa risoluzione. Le fonti senza tag di risoluzione vengono mantenute."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ẩn các nguồn dưới độ phân giải này. Các nguồn không có thẻ độ phân giải vẫn được giữ lại."
          }
        }
      }
    },
    "Hides sources your debrid service has not cached. This row only appears once a debrid service is connected. Off by default.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blendet Quellen aus, die dein Debrid-Dienst nicht im Cache hat. Diese Zeile erscheint erst, wenn ein Debrid-Dienst verbunden ist. Standardmäßig aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta las fuentes que tu servicio debrid no tiene en caché. Esta fila solo aparece cuando hay un servicio debrid conectado. Desactivado por defecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masque les sources que votre service debrid n’a pas en cache. Cette ligne n’apparaît qu’une fois un service debrid connecté. Désactivé par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasconde le fonti che il tuo servizio debrid non ha in cache. Questa riga appare solo dopo aver collegato un servizio debrid. Disattivato per impostazione predefinita."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ẩn các nguồn mà dịch vụ debrid của bạn chưa lưu đệm. Hàng này chỉ xuất hiện khi đã kết nối dịch vụ debrid. Mặc định tắt."
          }
        }
      }
    },
    "Hides the large artwork at the top of Home once you move down into the rows. Off by default, so the artwork stays visible.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blendet das große Artwork oben auf der Startseite aus, sobald du nach unten zu den Reihen wechselst. Standardmäßig aus, daher bleibt das Artwork sichtbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta la imagen grande de la parte superior de Inicio al bajar a las filas. Desactivado por defecto, por lo que la imagen permanece visible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masque le grand visuel en haut de l’accueil dès que vous descendez dans les rangées. Désactivé par défaut, le visuel reste donc visible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasconde la grande immagine in alto in Home quando scendi nelle righe. Disattivato per impostazione predefinita, quindi l’immagine resta visibile."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ẩn ảnh lớn ở đầu Trang chủ khi bạn di chuyển xuống các hàng. Mặc định tắt, nên ảnh vẫn hiển thị."
          }
        }
      }
    },
