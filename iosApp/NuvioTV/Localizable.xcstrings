    "Use the gpu-next (libplacebo) renderer for better HDR tone-mapping. Experimental — Apple TV hardware only (ignored on the Simulator). Applies to the next video.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende den gpu-next (libplacebo) Renderer für besseres HDR-Tone-Mapping. Experimentell – nur Apple-TV-Hardware (wird im Simulator ignoriert). Gilt für das nächste Video."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa el renderizador gpu-next (libplacebo) para mejor mapeo de tonos HDR. Experimental — solo hardware de Apple TV (ignorado en el Simulador). Se aplica al siguiente vídeo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise le moteur gpu-next (libplacebo) pour un meilleur tone-mapping HDR. Expérimental — matériel Apple TV uniquement (ignoré sur le simulateur). S'applique à la prochaine vidéo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa il renderer gpu-next (libplacebo) per una migliore mappatura dei toni HDR. Sperimentale — solo hardware Apple TV (ignorato sul simulatore). Si applica al video successivo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng trình kết xuất gpu-next (libplacebo) để tone-map HDR tốt hơn. Thử nghiệm — chỉ trên phần cứng Apple TV (bỏ qua trên Simulator). Áp dụng cho video tiếp theo."
          }
        }
      }
    },
