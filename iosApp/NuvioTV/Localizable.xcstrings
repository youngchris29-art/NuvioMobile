          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cam"
          }
        }
      }
    },
    "Ambient Background": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambiente-Hintergrund"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fondo ambiental"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrière-plan d’ambiance"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sfondo d’atmosfera"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nền hòa màu"
          }
        }
      }
    },
    "An A/B switch for a tab bar that stays half shown on Home. Relink reconnects the tab bar to Home's rows once they first come to rest. Snap to Top moves the first row fully back to the top when it rests a few points low. Relaunch after changing it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein A/B-Schalter für eine Tab-Leiste, die auf der Startseite halb sichtbar bleibt. „Neu verknüpfen“ verbindet die Tab-Leiste erneut mit den Reihen der Startseite, sobald sie zum ersten Mal zur Ruhe kommen. „Nach oben einrasten“ schiebt die erste Reihe ganz nach oben zurück, wenn sie ein paar Punkte zu tief liegen bleibt. Nach der Änderung neu starten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un interruptor A/B para una barra de pestañas que se queda a medio mostrar en Inicio. «Volver a vincular» conecta de nuevo la barra de pestañas con las filas de Inicio cuando se detienen por primera vez. «Ajustar arriba» devuelve la primera fila del todo arriba cuando se detiene unos puntos más abajo. Vuelve a abrir la app tras cambiarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un commutateur A/B pour une barre d’onglets qui reste à moitié visible sur l’accueil. « Relier à nouveau » reconnecte la barre d’onglets aux rangées de l’accueil dès qu’elles s’arrêtent pour la première fois. « Caler en haut » ramène la première rangée tout en haut quand elle s’arrête quelques points trop bas. Relancez l’app après modification."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un interruttore A/B per una barra delle schede che resta visibile a metà in Home. «Ricollega» ricollega la barra delle schede alle righe di Home appena si fermano per la prima volta. «Aggancia in alto» riporta la prima riga del tutto in alto quando si ferma qualche punto più in basso. Riavvia dopo la modifica."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Công tắc A/B cho thanh tab cứ hiện một nửa trên Trang chủ. “Liên kết lại” nối lại thanh tab với các hàng của Trang chủ khi chúng dừng lần đầu. “Kéo về đầu” đưa hàng đầu tiên về hẳn trên cùng khi nó dừng thấp hơn vài điểm. Khởi chạy lại sau khi thay đổi."
          }
        }
      }
    },
    "An A/B switch for how collection rows animate, to test choppy focus movement. 0 is the normal behavior.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein A/B-Schalter für die Animation von Kollektionsreihen, um ruckelnde Fokusbewegungen zu testen. 0 ist das normale Verhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un interruptor A/B para cómo se animan las filas de colecciones, para probar el movimiento de foco entrecortado. 0 es el comportamiento normal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un commutateur A/B pour l’animation des rangées de collections, afin de tester un déplacement du focus saccadé. 0 correspond au comportement normal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un interruttore A/B per come si animano le righe delle raccolte, per testare lo spostamento a scatti del focus. 0 è il comportamento normale."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Công tắc A/B cho cách các hàng bộ sưu tập chuyển động, để thử nghiệm chuyển tiêu điểm bị giật. 0 là hành vi bình thường."
          }
        }
      }
    },
    "An A/B switch that changes how Home's top edge scrolls, to test a tab bar that reappears clipped. Try it only if asked.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein A/B-Schalter, der das Scrollen am oberen Rand der Startseite ändert, um eine Tab-Leiste zu testen, die abgeschnitten wieder erscheint. Nur auf Anfrage ausprobieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un interruptor A/B que cambia cómo se desplaza el borde superior de Inicio, para probar una barra de pestañas que reaparece recortada. Pruébalo solo si se te pide."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un commutateur A/B qui modifie le défilement du bord supérieur de l’accueil, afin de tester une barre d’onglets qui réapparaît tronquée. À essayer uniquement si on vous le demande."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un interruttore A/B che cambia lo scorrimento del bordo superiore di Home, per testare una barra delle schede che riappare tagliata. Provalo solo se richiesto."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Công tắc A/B thay đổi cách cuộn mép trên của Trang chủ, để thử nghiệm thanh tab xuất hiện lại bị cắt. Chỉ thử khi được yêu cầu."
          }
        }
      }
    },
    "An A/B switch that makes short rows such as Continue Watching rest at the same height as poster rows.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein A/B-Schalter, der dafür sorgt, dass kurze Reihen wie „Weiterschauen“ auf derselben Höhe ruhen wie Posterreihen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un interruptor A/B que hace que las filas cortas, como Seguir viendo, se asienten a la misma altura que las filas de pósteres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un commutateur A/B qui fait reposer les rangées courtes, comme Reprendre la lecture, à la même hauteur que les rangées d’affiches."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un interruttore A/B che fa fermare le righe corte, come Continua a guardare, alla stessa altezza delle righe di poster."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Công tắc A/B giúp các hàng ngắn như Tiếp tục xem dừng ở cùng độ cao với các hàng poster."
          }
        }
      }
    },
    "An A/B switch that prefers 30 fps trailers over higher frame rates to test choppy playback. Auto is the normal behavior.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein A/B-Schalter, der 30-fps-Trailer gegenüber höheren Bildraten bevorzugt, um ruckelnde Wiedergabe zu testen. Automatisch ist das normale Verhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un interruptor A/B que prefiere los tráileres de 30 fps frente a velocidades de fotogramas superiores, para probar la reproducción entrecortada. Auto es el comportamiento normal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un commutateur A/B qui privilégie les bandes-annonces à 30 fps plutôt que des fréquences d’images plus élevées, afin de tester une lecture saccadée. Auto correspond au comportement normal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un interruttore A/B che preferisce i trailer a 30 fps rispetto a frequenze fotogrammi più alte, per testare la riproduzione a scatti. Auto è il comportamento normale."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Công tắc A/B ưu tiên trailer 30 fps hơn tốc độ khung hình cao hơn, để thử nghiệm phát bị giật. Tự động là hành vi bình thường."
          }
        }
      }
    },
    "An A/B switch that reserves extra room for row titles when No Zoom on Focus is on, to test titles that fade or bounce.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein A/B-Schalter, der zusätzlichen Platz für Reihentitel reserviert, wenn „Kein Zoom bei Fokus“ aktiv ist, um Titel zu testen, die ausblenden oder springen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un interruptor A/B que reserva espacio adicional para los títulos de las filas cuando Sin zoom al enfocar está activado, para probar títulos que se desvanecen o rebotan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un commutateur A/B qui réserve de l’espace supplémentaire pour les titres de rangées quand Pas de zoom au focus est activé, afin de tester des titres qui s’estompent ou rebondissent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un interruttore A/B che riserva spazio extra per i titoli delle righe quando Nessuno zoom al focus è attivo, per testare titoli che sfumano o rimbalzano."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Công tắc A/B dành thêm chỗ cho tiêu đề hàng khi Không phóng to khi chọn bật, để thử nghiệm tiêu đề bị mờ hoặc nảy."
          }
        }
      }
    },
    "An A/B switch that sets how many seconds of trailer are buffered before playing. Auto is the normal behavior.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein A/B-Schalter, der festlegt, wie viele Sekunden Trailer vor der Wiedergabe gepuffert werden. Automatisch ist das normale Verhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un interruptor A/B que define cuántos segundos de tráiler se almacenan en búfer antes de reproducirlo. Auto es el comportamiento normal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un commutateur A/B qui définit combien de secondes de bande-annonce sont mises en mémoire tampon avant la lecture. Auto correspond au comportement normal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un interruttore A/B che imposta quanti secondi di trailer vengono messi in buffer prima della riproduzione. Auto è il comportamento normale."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Công tắc A/B đặt số giây trailer được đệm trước khi phát. Tự động là hành vi bình thường."
          }
        }
      }
    },
    "An A/B switch that skips the check for black bars around trailers. Leave it off unless asked.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein A/B-Schalter, der die Prüfung auf schwarze Balken um Trailer überspringt. Ausgeschaltet lassen, sofern nicht angefordert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un interruptor A/B que omite la comprobación de franjas negras alrededor de los tráileres. Déjalo desactivado salvo que se te pida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un commutateur A/B qui ignore la détection des bandes noires autour des bandes-annonces. À laisser désactivé sauf demande contraire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un interruttore A/B che salta il controllo delle bande nere attorno ai trailer. Lascialo disattivato se non richiesto."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Công tắc A/B bỏ qua việc kiểm tra viền đen quanh trailer. Để tắt trừ khi được yêu cầu."
          }
        }
      }
    },
    "An A/B switch that tells the tab bar which scroll view on Home to follow. Relaunch after changing it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein A/B-Schalter, der der Tab-Leiste mitteilt, welcher Scrollbereich auf der Startseite verfolgt werden soll. Nach der Änderung neu starten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un interruptor A/B que indica a la barra de pestañas qué vista de desplazamiento de Inicio debe seguir. Vuelve a abrir la app tras cambiarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un commutateur A/B qui indique à la barre d’onglets quelle vue défilante de l’accueil suivre. Relancez l’app après modification."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un interruttore A/B che indica alla barra delle schede quale vista a scorrimento di Home seguire. Riavvia dopo la modifica."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Công tắc A/B cho thanh tab biết nên theo dõi vùng cuộn nào trên Trang chủ. Khởi chạy lại sau khi thay đổi."
          }
        }
      }
    },
    "An A/B switch that tries different ways of scrolling title pages to test a stutter. Leave it Off unless asked.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein A/B-Schalter, der verschiedene Arten des Scrollens von Titelseiten ausprobiert, um ein Ruckeln zu testen. Ausgeschaltet lassen, sofern nicht angefordert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un interruptor A/B que prueba distintas formas de desplazar las páginas de títulos, para probar un tirón. Déjalo desactivado salvo que se te pida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un commutateur A/B qui essaie différentes façons de faire défiler les pages de titres, afin de tester un à-coup. À laisser désactivé sauf demande contraire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un interruttore A/B che prova diversi modi di scorrere le pagine dei titoli, per testare uno scatto. Lascialo disattivato se non richiesto."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Công tắc A/B thử các cách cuộn trang tiêu đề khác nhau, để thử nghiệm hiện tượng giật. Để tắt trừ khi được yêu cầu."
          }
        }
      }
    },
    "Anime": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anime"
          }
        },
