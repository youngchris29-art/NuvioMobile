    "Turn cached torrent results into direct links automatically": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwandle gecachte Torrent-Ergebnisse automatisch in direkte Links"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierte resultados de torrents en caché en enlaces directos automáticamente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transforme automatiquement les résultats torrent mis en cache en liens directs"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Converti automaticamente i risultati torrent memorizzati in cache in collegamenti diretti"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự động chuyển kết quả torrent đã cache thành liên kết trực tiếp"
          }
        }
      }
    },
    "Turn on before walking Home down and back up, or running Detail push/pop cycles": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einschalten, bevor du die Startseite nach unten und wieder nach oben durchgehst oder Detail-Push/Pop-Zyklen ausführst"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actívalo antes de recorrer Inicio hacia abajo y de nuevo hacia arriba, o de ejecutar ciclos de push/pop de Detalle"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À activer avant de parcourir l’accueil vers le bas puis vers le haut, ou de lancer des cycles push/pop de Détails"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivalo prima di scorrere Home in giù e di nuovo in su, o di eseguire cicli push/pop di Dettaglio"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật trước khi lướt Trang chủ xuống rồi lên lại, hoặc chạy các chu kỳ push/pop của Chi tiết"
          }
        }
      }
    },
    "Turn on if asked to capture a hero artwork report, then relaunch the app": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einschalten, wenn du einen Bericht zum Hero-Artwork aufzeichnen sollst, dann die App neu starten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actívalo si se te pide capturar un informe de la imagen del hero y vuelve a abrir la app"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À activer si on vous demande de capturer un rapport sur le visuel du hero, puis relancez l’app"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivalo se ti viene chiesto di catturare un report sull’immagine dell’hero, poi riavvia l’app"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật nếu được yêu cầu ghi lại báo cáo ảnh hero, sau đó khởi chạy lại ứng dụng"
          }
        }
      }
    },
    "Turn on if asked to capture a row position report, then relaunch the app": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez si l'on vous demande un rapport de position des rangées, puis relancez l'app"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einschalten, wenn ein Bericht zur Zeilenposition angefordert wird, dann die App neu starten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actívalo si te piden un informe de posición de filas y luego reinicia la app"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva se ti viene chiesto un rapporto sulla posizione delle righe, poi riavvia l'app"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật nếu được yêu cầu gửi báo cáo vị trí hàng, sau đó khởi động lại ứng dụng"
          }
        }
      }
    },
    "Turn on if asked to capture the tab bar's on-device geometry, then relaunch the app": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez si l'on vous demande de capturer la géométrie de la barre d'onglets sur l'appareil, puis relancez l'app"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einschalten, wenn die Geometrie der Tab-Leiste auf dem Gerät erfasst werden soll, dann die App neu starten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actívalo si te piden capturar la geometría de la barra de pestañas en el dispositivo, luego reinicia la app"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva se ti viene chiesto di acquisire la geometria della barra delle schede sul dispositivo, poi riavvia l'app"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật nếu được yêu cầu ghi lại hình học thanh tab trên thiết bị, sau đó khởi động lại ứng dụng"
          }
        }
      }
    },
    "Turn on if asked to capture why a title finds no streams": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einschalten, wenn du aufzeichnen sollst, warum ein Titel keine Streams findet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actívalo si se te pide capturar por qué un título no encuentra streams"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À activer si on vous demande de capturer pourquoi un titre ne trouve aucun stream"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivalo se ti viene chiesto di catturare perché un titolo non trova stream"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật nếu được yêu cầu ghi lại vì sao một tiêu đề không tìm được luồng"
          }
        }
      }
    },
    "Turn on if asked to capture why a trailer looks zoomed or letterboxed": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren, wenn du gebeten wirst zu erfassen, warum ein Trailer gezoomt oder mit Letterbox aussieht"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actívalo si te piden capturar por qué un tráiler se ve con zoom o con bandas negras"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active si on te demande de relever pourquoi une bande-annonce semble zoomée ou avec des bandes noires"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva se ti viene chiesto di rilevare perché un trailer sembra ingrandito o con bande nere"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật nếu được yêu cầu ghi lại lý do trailer trông bị phóng to hoặc có viền đen"
          }
        }
      }
    },
    "Turn on if asked to capture why a trailer looks zoomed, letterboxed or stutters": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einschalten, wenn du aufzeichnen sollst, warum ein Trailer gezoomt, mit Letterbox oder ruckelnd aussieht"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actívalo si se te pide capturar por qué un tráiler se ve con zoom, con franjas negras o con tirones"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À activer si on vous demande de capturer pourquoi une bande-annonce paraît zoomée, avec bandes noires ou saccadée"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivalo se ti viene chiesto di catturare perché un trailer appare ingrandito, con bande nere o a scatti"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật nếu được yêu cầu ghi lại vì sao trailer trông bị phóng to, có viền đen hoặc bị giật"
          }
        }
      }
    },
    "Turns cached torrent results into direct streaming links for you automatically. It only appears once a debrid service is connected.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wandelt Torrent-Ergebnisse aus dem Cache automatisch in direkte Streaming-Links um. Erscheint erst, wenn ein Debrid-Dienst verbunden ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierte automáticamente los resultados de torrents en caché en enlaces de streaming directos. Solo aparece cuando hay un servicio debrid conectado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Convertit automatiquement les résultats de torrents en cache en liens de streaming directs. N’apparaît qu’une fois un service debrid connecté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasforma automaticamente i risultati torrent in cache in link di streaming diretti. Appare solo dopo aver collegato un servizio debrid."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự động chuyển kết quả torrent đã lưu đệm thành liên kết phát trực tiếp. Chỉ xuất hiện khi đã kết nối dịch vụ debrid."
          }
        }
      }
    },
    "Turns the depth effect on or off for this kind of card. Each kind is on by default.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltet den Tiefeneffekt für diese Art von Karte ein oder aus. Jede Art ist standardmäßig eingeschaltet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa o desactiva el efecto de profundidad para este tipo de tarjeta. Cada tipo está activado por defecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active ou désactive l’effet de profondeur pour ce type de carte. Chaque type est activé par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva o disattiva l’effetto di profondità per questo tipo di riquadro. Ogni tipo è attivo per impostazione predefinita."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật hoặc tắt hiệu ứng chiều sâu cho loại thẻ này. Mỗi loại mặc định bật."
          }
        }
      }
    },
    "Turns this catalog on or off as a source for the rotating banner. At most two can be on at once.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltet diesen Katalog als Quelle für das rotierende Banner ein oder aus. Höchstens zwei können gleichzeitig eingeschaltet sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa o desactiva este catálogo como fuente del banner rotativo. Solo puede haber dos activados a la vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active ou désactive ce catalogue comme source de la bannière rotative. Deux au maximum peuvent être activés en même temps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva o disattiva questo catalogo come fonte per il banner a rotazione. Al massimo due possono essere attivi insieme."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật hoặc tắt danh mục này làm nguồn cho biểu ngữ xoay vòng. Chỉ tối đa hai mục được bật cùng lúc."
          }
        }
      }
    },
    "Turns this catalog on or off for Search. Fewer catalogs gives faster results. This applies to this Apple TV only.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltet diesen Katalog für die Suche ein oder aus. Weniger Kataloge liefern schnellere Ergebnisse. Gilt nur für dieses Apple TV."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa o desactiva este catálogo en la búsqueda. Menos catálogos dan resultados más rápidos. Se aplica solo a este Apple TV."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active ou désactive ce catalogue dans la recherche. Moins de catalogues donnent des résultats plus rapides. S’applique uniquement à cette Apple TV."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva o disattiva questo catalogo nella ricerca. Meno cataloghi danno risultati più veloci. Vale solo per questa Apple TV."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật hoặc tắt danh mục này cho Tìm kiếm. Ít danh mục hơn cho kết quả nhanh hơn. Chỉ áp dụng cho Apple TV này."
          }
        }
      }
    },
    "Turns this plugin provider on or off. Only enabled providers are used when streams load.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltet diesen Plugin-Provider ein oder aus. Beim Laden von Streams werden nur aktivierte Provider verwendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa o desactiva este proveedor de plugins. Solo se usan los proveedores activados al cargar los streams."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active ou désactive ce fournisseur de plug-ins. Seuls les fournisseurs activés sont utilisés au chargement des streams."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva o disattiva questo provider di plugin. Solo i provider attivati vengono usati al caricamento degli stream."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật hoặc tắt nhà cung cấp plugin này. Chỉ các nhà cung cấp đã bật được dùng khi tải luồng."
          }
        }
      }
    },
