    "Badge pack JSON URL": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Badge-Paket-JSON-URL"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "URL JSON del paquete de insignias"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "URL JSON du pack de badges"
          }
        },
        "it": {
