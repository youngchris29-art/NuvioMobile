    "Remembers what you search for and shows it on the Search screen. Off hides past searches and stops saving new ones. On by default.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Merkt sich, wonach du suchst, und zeigt es auf dem Suchbildschirm an. „Aus“ blendet frühere Suchen aus und speichert keine neuen. Standardmäßig ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuerda lo que buscas y lo muestra en la pantalla de búsqueda. Desactivado oculta las búsquedas anteriores y deja de guardar nuevas. Activado por defecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mémorise vos recherches et les affiche sur l’écran Recherche. Désactivé masque les recherches passées et cesse d’en enregistrer. Activé par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricorda ciò che cerchi e lo mostra nella schermata Cerca. Disattivato nasconde le ricerche passate e smette di salvarne di nuove. Attivato per impostazione predefinita."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi nhớ những gì bạn tìm kiếm và hiển thị trên màn hình Tìm kiếm. Tắt sẽ ẩn các tìm kiếm trước và ngừng lưu tìm kiếm mới. Mặc định bật."
          }
        }
      }
    },
