            "value": "api.nuvio.tv là máy chủ chính thức và đã được chọn."
          }
        }
      }
    },
    "api.nuvio.tv is the official server. Use “Use Official Server” in Settings → Account & Profiles to switch back.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "api.nuvio.tv ist der offizielle Server. Verwende „Offiziellen Server verwenden“ unter Einstellungen → Account & Profile, um zurückzuwechseln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "api.nuvio.tv es el servidor oficial. Usa “Usar servidor oficial” en Ajustes → Cuenta y perfiles para volver."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "api.nuvio.tv est le serveur officiel. Utilisez « Utiliser le serveur officiel » dans Réglages → Compte et profils pour revenir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "api.nuvio.tv è il server ufficiale. Usa “Usa server ufficiale” in Impostazioni → Account e profili per tornare indietro."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
