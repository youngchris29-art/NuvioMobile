        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'account non ha concesso i permessi necessari."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tài khoản chưa cấp các quyền cần thiết."
          }
        }
      }
    },
    "The app version and build number running on this Apple TV. Include it when you report a bug.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App-Version und Build-Nummer, die auf diesem Apple TV läuft. Bei einem Fehlerbericht angeben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
