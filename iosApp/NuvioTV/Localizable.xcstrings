    "Device sign-in isn't available for %@. Use manual API key entry below.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geräte-Anmeldung ist für %@ nicht verfügbar. Verwende manuelle API-Schlüsseleingabe unten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión del dispositivo no está disponible para %@. Usa la entrada manual de clave API abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion par appareil n'est pas disponible pour %@. Utilisez la saisie manuelle de la clé API ci-dessous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso al dispositivo non è disponibile per %@. Usa l'immissione manuale della chiave API di seguito."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập bằng thiết bị không khả dụng cho %@. Dùng nhập API key thủ công bên dưới."
          }
        }
      }
    },
    "Device sign-in isn't configured in this build (missing PREMIUMIZE_CLIENT_ID). Paste an API key from your Premiumize account instead.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geräte-Anmeldung ist in dieser Version nicht konfiguriert (fehlende PREMIUMIZE_CLIENT_ID). Füge stattdessen einen API-Schlüssel aus deinem Premiumize-Konto ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión del dispositivo no está configurado en esta compilación (falta PREMIUMIZE_CLIENT_ID). Pega una clave API de tu cuenta de Premiumize en su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion par appareil n'est pas configurée dans cette version (PREMIUMIZE_CLIENT_ID manquant). Collez plutôt une clé API de votre compte Premiumize."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso al dispositivo non è configurato in questa build (manca PREMIUMIZE_CLIENT_ID). Incolla invece una chiave API dal tuo account Premiumize."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập bằng thiết bị chưa được cấu hình trong bản dựng này (thiếu PREMIUMIZE_CLIENT_ID). Hãy dán API key từ tài khoản Premiumize của bạn."
          }
        }
      }
    },
    "Device sign-in isn't supported for this provider.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geräte-Anmeldung wird für diesen Anbieter nicht unterstützt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión del dispositivo no es compatible con este proveedor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion par appareil n'est pas prise en charge pour ce fournisseur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso al dispositivo non è supportato per questo fornitore."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhà cung cấp này không hỗ trợ đăng nhập bằng thiết bị."
          }
        }
      }
    },
    "Diagnostic readouts and test switches used when chasing a bug report. Leave them alone unless you've been asked to capture something.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnoseanzeigen und Testschalter für die Fehlersuche bei Fehlerberichten. Nicht verändern, sofern du nicht darum gebeten wurdest, etwas aufzuzeichnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lecturas de diagnóstico e interruptores de prueba que se usan al investigar un informe de error. No los toques salvo que se te haya pedido capturar algo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relevés de diagnostic et commutateurs de test utilisés pour traquer un bug signalé. N’y touchez pas sauf si on vous a demandé de capturer quelque chose."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Letture diagnostiche e interruttori di prova usati per cercare un bug segnalato. Non toccarli a meno che non ti sia stato chiesto di catturare qualcosa."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các số liệu chẩn đoán và công tắc thử nghiệm dùng khi tìm lỗi được báo cáo. Đừng động vào trừ khi bạn được yêu cầu ghi lại điều gì đó."
          }
        }
      }
    },
