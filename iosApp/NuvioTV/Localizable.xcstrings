    "Apply changes from browser?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen aus dem Browser anwenden?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Aplicar cambios del navegador?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appliquer les modifications depuis le navigateur ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Applicare le modifiche dal browser?"
          }
        },
        "vi": {
