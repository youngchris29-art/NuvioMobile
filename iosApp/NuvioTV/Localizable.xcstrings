    "Control how playback starts and behaves: the default player, intro skipping, frame-rate matching, Dolby Vision handling and buffering.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steuere, wie die Wiedergabe startet und sich verhält: Standard-Player, Intro-Überspringen, Bildrate anpassen, Dolby-Vision-Verarbeitung und Pufferung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla cómo empieza y se comporta la reproducción: reproductor predeterminado, omisión de intros, ajuste de fotogramas, gestión de Dolby Vision y almacenamiento en búfer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrôlez le démarrage et le comportement de la lecture : lecteur par défaut, saut des intros, adaptation de la fréquence d’images, gestion de Dolby Vision et mémoire tampon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla come parte e si comporta la riproduzione: player predefinito, salto delle intro, adattamento della frequenza fotogrammi, gestione di Dolby Vision e buffering."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều khiển cách phát bắt đầu và hoạt động: trình phát mặc định, bỏ qua phần mở đầu, khớp tốc độ khung hình, xử lý Dolby Vision và đệm."
          }
        }
      }
    },
