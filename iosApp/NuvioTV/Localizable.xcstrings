    "Positive values delay the track; negative values play it earlier.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Positive Werte verzögern die Spur; negative Werte spielen sie früher ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los valores positivos retrasan la pista; los valores negativos la reproducen antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les valeurs positives retardent la piste ; les valeurs négatives l'avancent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I valori positivi ritardano la traccia; i valori negativi la riproducono in precedenza."
          }
        },
        "vi": {
