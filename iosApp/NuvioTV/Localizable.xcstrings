    "Sign-in failed. Try again, or paste an API key manually below.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldung fehlgeschlagen. Versuche es erneut, oder füge einen API-Schlüssel manuell unten ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicio de sesión fallido. Intenta de nuevo o pega una clave API manualmente abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de la connexion. Réessayez, ou collez une clé API manuellement ci-dessous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso non riuscito. Riprova o incolla una chiave API manualmente di seguito."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập thất bại. Thử lại, hoặc dán API key thủ công bên dưới."
          }
        }
      }
    },
    "Signed in as %@. Local data on this Apple TV will be cleared.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angemeldet als %@. Lokale Daten auf diesem Apple TV werden gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesión iniciada como %@. Los datos locales en este Apple TV se borrarán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecté en tant que %@. Les données locales de cet Apple TV seront effacées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connesso come %@. I dati locali su questo Apple TV verranno cancellati."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã đăng nhập là %@. Dữ liệu cục bộ trên Apple TV này sẽ bị xóa."
          }
        }
      }
    },
