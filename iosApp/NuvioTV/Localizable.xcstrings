          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Căn thời gian"
          }
        }
      }
    },
    "Tints each card's depth edge with its poster's main color as the artwork loads. Off by default.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Färbt die Tiefenkante jeder Karte beim Laden des Artworks mit der Hauptfarbe ihres Posters. Standardmäßig aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiñe el borde de profundidad de cada tarjeta con el color principal de su póster al cargar la imagen. Desactivado por defecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Teinte le bord de profondeur de chaque carte avec la couleur principale de son affiche au chargement du visuel. Désactivé par défaut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Colora il bordo di profondità di ogni riquadro con il colore principale del suo poster al caricamento dell’immagine. Disattivato per impostazione predefinita."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhuộm viền chiều sâu của từng thẻ bằng màu chính của poster khi hình ảnh tải xong. Mặc định tắt."
          }
        }
      }
    },
    "Title and description on the left, artwork on the right, hero pinned while rows scroll": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Titel und Beschreibung links, Artwork rechts, Hero bleibt beim Scrollen der Reihen fixiert"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Título y descripción a la izquierda, imagen a la derecha, hero fijo mientras se desplazan las filas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Titre et description à gauche, visuel à droite, hero fixe pendant le défilement des rangées"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
